-test('a vertex another way is attached to stays exactly, and the road still bends smoothly through it', () => {
+// the smallest radius of a polyline, from each three consecutive points (m)
+function minRadius(geometry) {
+  const P = geometry.map(xy);
+  let min = Infinity;
+  for (let i = 1; i + 1 < P.length; i++) {
+    const [a, b, c] = [P[i - 1], P[i], P[i + 1]];
+    const ab = Math.hypot(b[0] - a[0], b[1] - a[1]); const bc = Math.hypot(c[0] - b[0], c[1] - b[1]); const ca = Math.hypot(a[0] - c[0], a[1] - c[1]);
+    const area2 = Math.abs((b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0]));
+    if (area2 > 1e-9) min = Math.min(min, (ab * bc * ca) / (2 * area2));
+  }
+  return min;
+}
+
+test('a sharp bend at a vertex another way only ends at is rounded; the vertex moves onto the arc and that way follows', () => {
+  // (before: the road was pinned through the vertex, an S with a tight core:
+  // a 53 degree bend at a driveway on 25 m and 20 m legs drew under 8 m of radius)
+  const r = road('r', [[0, 0], [20, 15], [39, 9]]);
+  const drive = { id: 'd', type: 'road', tags: { highway: 'service' }, geometry: [r.geometry[1], ll(30, 40)] };
+  const { features, stats } = roundRoadCorners([r, drive]);
+  const g = features[0].geometry;
+  assert.ok(minRadius(g) > 15, `min radius ${minRadius(g).toFixed(1)} m`);
+  const start = features[1].geometry[0];
+  assert.ok(g.some((p) => makeRoadNodeKey(p) === makeRoadNodeKey(start)), 'driveway still attached, on the arc');
+  const moved = Math.hypot(xy(start)[0] - 20, xy(start)[1] - 15);
+  assert.ok(moved > 0.5 && moved < 3.1, `vertex moved ${moved.toFixed(2)} m`);
+  assert.equal(stats.movedEnds, 1);
+});
+
