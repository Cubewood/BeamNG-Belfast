     if (!inside || !onLanes) { out.push(f); continue; }
@@ -226,10 +239,15 @@ export function resolveBuildingRoadConflicts(features, { project, unproject, urb
       out.push(f);
       continue;
     }
-    const keepAsMapped = () => { if (share >= LIST_SHARE) flagged.push({ id, share, run }); out.push(f); };
+    // belfast patch (T-412): by absolute overlap and depth as well as by share,
+    // so a large footprint with a small share in the lanes is cut back, and when
