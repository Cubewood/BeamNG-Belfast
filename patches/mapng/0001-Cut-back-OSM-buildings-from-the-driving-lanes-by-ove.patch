+    const overlapM2 = (onLanes / inside) * area;
+    const reachesLanes = overlapM2 >= OSM_CLIP_MIN_M2 && depth >= OSM_CLIP_MIN_DEPTH_M;
+    const keepAsMapped = () => { if (share >= LIST_SHARE || reachesLanes) flagged.push({ id, share, run, overlapM2, depth }); out.push(f); };
     // (largely on the road: a passage or a misplaced line, the mapper's to
