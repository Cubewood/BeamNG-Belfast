diff --git a/tests/buildingRoadConflicts.test.mjs b/tests/buildingRoadConflicts.test.mjs
index 2acff4e..44202aa 100644
--- a/tests/buildingRoadConflicts.test.mjs
+++ b/tests/buildingRoadConflicts.test.mjs
@@ -73,3 +73,36 @@ test('a building flush with the kerb, outside the lanes, is untouched', () => {
   assert.equal(r.dropped.length + r.clipped.length, 0);
   assert.equal(r.features.find((f) => f.id === 'way_flush'), flush);
 });
+
+// belfast patch (T-412): a large footprint with a small share in the lanes
+test('a large OSM footprint with a small lane overlap is cut back by area and depth, not share', () => {
+  // 40 x 20 m block (800 m2) whose front wall stands 0.5 m into the lanes: about 20 m2, 2.5% of the footprint
+  const block = { id: 'way_block', type: 'building', tags: { building: 'yes' }, geometry: rect(-20, 2.8, 20, 22.8) };
+  const r = run([street(), block]);
+  assert.equal(r.clipped.length, 1, 'cut back');
+  assert.ok(r.clipped[0].share < 0.03, `share ${r.clipped[0].share.toFixed(3)} is under the old 3% line`);
+  assert.ok(r.clipped[0].overlapM2 >= 1 && r.clipped[0].depth >= 0.15);
+  assert.equal(r.flagged.length, 0);
+  const cut = r.features.find((f) => f.id === 'way_block');
+  const ys = cut.geometry.map((p) => project(p.lat, p.lng)[1]);
+  assert.ok(Math.min(...ys) >= 3.2, `front wall at y ${Math.min(...ys).toFixed(2)} is outside the lanes`);
+  assert.ok(Math.abs(Math.max(...ys) - 22.8) < 1e-6, 'the back wall stays');
+  assert.equal(cut.tags['mapng:clipped_from_road'], 'yes');
+});
+
+test('a large footprint with a hairline overlap is left alone and not listed', () => {
+  // front wall a few cm into the lanes: under the 0.15 m depth
+  const hairline = { id: 'way_hair', type: 'building', tags: { building: 'yes' }, geometry: rect(-20, 3.25, 20, 23.25) };
+  const r = run([street(), hairline]);
+  assert.equal(r.clipped.length + r.flagged.length + r.dropped.length, 0);
+  assert.equal(r.features.find((f) => f.id === 'way_hair'), hairline);
+});
+
+test('a large footprint with a small overlap that cannot be cut back (a courtyard) is kept as mapped and listed', () => {
+  const courtyard = { id: 'way_court', type: 'building', tags: { building: 'yes' }, geometry: rect(-20, 2.8, 20, 22.8), holes: [rect(-3, 10, 3, 15)] };
+  const r = run([street(), courtyard]);
+  assert.equal(r.clipped.length, 0);
+  assert.deepEqual(r.flagged.map((d) => d.id), ['way_court']);
+  assert.ok(r.flagged[0].share < 0.03 && r.flagged[0].overlapM2 >= 1 && r.flagged[0].depth >= 0.15);
+  assert.ok(r.features.includes(courtyard));
+});
