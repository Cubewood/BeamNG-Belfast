@@ -163,12 +172,13 @@ export function resolveBuildingRoadConflicts(features, { project, unproject, urb
     return [...out].map((i) => segs[i]);
   };
   // the segment whose lanes hold (x, y), or null
+  const segDist = (s, x, y) => {
+    const vx = s.b[0] - s.a[0]; const vy = s.b[1] - s.a[1]; const L2 = vx * vx + vy * vy;
+    const t = L2 > 1e-9 ? Math.max(0, Math.min(1, ((x - s.a[0]) * vx + (y - s.a[1]) * vy) / L2)) : 0;
+    return Math.hypot(s.a[0] + vx * t - x, s.a[1] + vy * t - y);
+  };
   const laneAt = (x, y, near) => {
-    for (const s of near) {
-      const vx = s.b[0] - s.a[0]; const vy = s.b[1] - s.a[1]; const L2 = vx * vx + vy * vy;
-      const t = L2 > 1e-9 ? Math.max(0, Math.min(1, ((x - s.a[0]) * vx + (y - s.a[1]) * vy) / L2)) : 0;
-      if (Math.hypot(s.a[0] + vx * t - x, s.a[1] + vy * t - y) <= s.half) return s;
-    }
+    for (const s of near) if (segDist(s, x, y) <= s.half) return s;
     return null;
   };
 
@@ -193,7 +203,7 @@ export function resolveBuildingRoadConflicts(features, { project, unproject, urb
     const area = Math.max(1e-6, ringArea(ring) - holes.reduce((n, h) => n + ringArea(h), 0));
     // share of the footprint on driving lanes (sampled), and by which segments
     const step = Math.max(SAMPLE_MIN_M, Math.sqrt(area / SAMPLE_TARGET));
-    let inside = 0; let onLanes = 0;
+    let inside = 0; let onLanes = 0; let depth = 0;
     const bySeg = new Map();
     for (let y = y0 + step / 2; y < y1; y += step) {
       // (per row: the footprint's crossings, and only the segments whose
@@ -204,7 +214,10 @@ export function resolveBuildingRoadConflicts(features, { project, unproject, urb
         if (!inRow(xs, x) || holeXs.some((h) => inRow(h, x))) continue;
         inside++;
         const s = rowNear.length ? laneAt(x, y, rowNear) : null;
-        if (s) { onLanes++; bySeg.set(s, (bySeg.get(s) || 0) + 1); }
+        if (s) {
+          onLanes++; bySeg.set(s, (bySeg.get(s) || 0) + 1);
+          depth = Math.max(depth, s.half - segDist(s, x, y)); // belfast patch (T-412): past the cut line
