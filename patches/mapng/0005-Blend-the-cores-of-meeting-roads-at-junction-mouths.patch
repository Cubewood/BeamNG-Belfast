From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Belfast Patches <belfast-patches@users.noreply.github.com>
Date: Sat, 14 Nov 2026 20:13:37 +0000
Subject: [PATCH] Blend the cores of meeting roads at junction mouths

Inside two road cores the nearer centreline owned a pixel outright, so where a
side street met a road on a slope their flat cross-sections met in a step along
the line midway between the centrelines: the side street's level on one half of
the road, the road's own grade on the other (0.06 m per metre out from the
road's centreline for a street on a 6 % grade: 26-28 cm across a lane).

composeTerrain now keeps every road core's claim on a pixel where two roads'
cores overlap, and where those roads share a node (directly, or through another
road on the pixel) the pixel gets their blend: each road weighted by
smoothstep(1 - d / core), 1 on its centreline and 0 at its core's edge, so the
surface warps across the full width of both and meets each road's own surface
where the other's core ends. A claim more than CORE_STEP_M / 2 from the owner's
height fades out by CORE_STEP_M, where the two-level rule (the lower road keeps
its width) takes over as before. Roads that do not meet keep the nearest-
centreline rule (a step midway, where a wall stands).

Past a road's end at a node it shares on the ground (no deck or tube there) its
surface now carries on at the end's grade, fitted over 8 m, instead of flat at
the end's height; an edge shorter than that stays flat. Without it the flat disc
blended into the road carrying on through the node would flatten its grade.

Tests: a T-junction on a 6 % side street (0.24 m across the main road's lanes
before, under 0.1 m now), a road split at a node on a grade keeps its grade, and
two parallel roads that do not meet keep their own surfaces.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/services/structures/terrainCompose.js b/services/structures/terrainCompose.js
index dde7b58..a392f8a 100644
--- a/services/structures/terrainCompose.js
+++ b/services/structures/terrainCompose.js
@@ -24,6 +24,22 @@ const ABUTMENT_M = 8;
 const CORE_STEP_M = 2;          // road cores this far apart in height are on two levels
 const CORE_OUTER = 0.6;         // ...where the lower road may take the upper's outer core only
 const DECK_ABUT_CLEAR_M = 0.3;  // abutment fill stops this far under the deck's underside          // a deck end on fill rests on it this far: no cap there
+// Junction mouths. Inside two cores the nearer centreline owns a pixel, so
+// where a side street meets a road on a slope the two flat cross-sections met
+// in a step along the line midway between their centrelines: the side
+// street's level on one half of the road, the road's own grade on the rest
+// (26-28 cm across a lane, a street on a 6 % grade). Where the cores of roads
+// that share a node overlap, the surface is their blend instead: each road
+// weighted by how far inside its own core the pixel lies (1 on its
+// centreline, 0 at its core's edge), so it warps across the full width of both
+// and meets each road's own surface where the other's core ends. A claim
+// further in height from the owner's than BLEND_FADE_M fades out by
+// CORE_STEP_M (two levels: the lower road keeps its width, as above).
+const BLEND_FADE_M = CORE_STEP_M / 2;
+// (past a road's end at a node it shares, its surface carries on at its own
+// grade, fitted over this far, not flat at the end's height: a flat disc
+// there blended into the road carrying on flattened its grade at every node)
+const END_GRADE_M = 8;
 
 const smoothstep = (t) => (t <= 0 ? 0 : t >= 1 ? 1 : t * t * (3 - 2 * t));
 
@@ -78,7 +94,7 @@ export function composeTerrain(graph, grid) {
     const key = Math.floor(c / TILE) * 65536 + Math.floor(r / TILE);
     let t = tiles.get(key);
     if (!t) {
-      t = { h: new Float32Array(TILE * TILE), w: new Float32Array(TILE * TILE).fill(Infinity), q: new Float32Array(TILE * TILE).fill(1), n: new Uint8Array(TILE * TILE), cap: new Float32Array(TILE * TILE).fill(Infinity) };
+      t = { h: new Float32Array(TILE * TILE), w: new Float32Array(TILE * TILE).fill(Infinity), q: new Float32Array(TILE * TILE).fill(1), n: new Uint8Array(TILE * TILE), cap: new Float32Array(TILE * TILE).fill(Infinity), k: new Int32Array(TILE * TILE).fill(-1) };
       tiles.set(key, t);
     }
     return t;
@@ -151,8 +167,45 @@ export function composeTerrain(graph, grid) {
   // proud
   const left = new Set();
   const abutmentOff = (kind, k, j) => (kind === 'deck' && toAbutment[k][j] < ABUTMENT_M ? DECK_UNDER_M : 0);
+  // a node two or more roads share on the ground (no deck or tube there):
+  // past a road's end at one its surface carries on at the end's grade
+  const openNode = (id) => {
+    const kinds = id === undefined ? null : nodeKinds.get(id);
+    return !!kinds && kinds.length >= 2 && kinds.every((kk) => kk !== 'deck' && !TUBE.has(kk));
+  };
+  // dz per metre of s at one end of an edge, over END_GRADE_M (an edge
+  // shorter than that, a junction's stub, has no grade to carry on: 0)
+  const endGrade = (k, atEnd) => {
+    const e = graph.edges[k]; const zk = z[k]; const n = e.s.length;
+    const i0 = atEnd ? n - 1 : 0; const dir = atEnd ? -1 : 1;
+    let i1 = i0;
+    while (i1 + dir >= 0 && i1 + dir < n && Math.abs(e.s[i1] - e.s[i0]) < END_GRADE_M) i1 += dir;
+    const ds = e.s[i1] - e.s[i0];
+    return Math.abs(ds) >= END_GRADE_M - 1e-6 && Number.isFinite(zk[i1] - zk[i0]) ? (zk[i1] - zk[i0]) / ds : 0;
+  };
+  // the junction-mouth blend's claims: pixel -> [edge, distance, core, height]
+  // per road whose core reaches it, kept only where two roads' cores overlap
+  const claims = new Map();
+  const claim = (idx, t, j, k, d, core, zt) => {
+    let list = claims.get(idx);
+    if (!list) {
+      // (the pixel's first core, or more of the same road's: nothing to blend yet)
+      if (!(t.w[j] < -500) || t.k[j] < 0 || t.k[j] === k) return;
+      list = [t.k[j], t.w[j] + 1000, graph.edges[t.k[j]].half + SHOULDER_M, t.h[j]];
+      claims.set(idx, list);
