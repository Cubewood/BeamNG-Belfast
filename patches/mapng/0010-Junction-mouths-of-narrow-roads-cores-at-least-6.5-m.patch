+test('narrow roads at a junction: the turn from a steep side street is spread over the mouth', () => {
+  // a level 5 m road along x split at the node, a 5 m side street from it up
+  // a 15 % grade (cores 3.5 m): a left turn's path round the corner changed
+  // grade within a couple of metres (vertical radius 2.6 m over 1 m) before
+  // the cores were widened to 6.5 m in the mouth
+  const flat = () => 0; const up = (x, y) => 0.15 * y;
+  const graph = mouthGraph([
+    mouthEdge(-80, 0, 1, 0, 21, 2.5, flat, 'w', 'j'),
+    mouthEdge(0, 0, 1, 0, 21, 2.5, flat, 'j', 'e'),
+    mouthEdge(0, 0, 0, 1, 21, 2.5, up, 'j', 'n'),
+  ]);
+  const out = composeTerrain(graph, mouthGrid((x, y) => Math.max(0, 0.15 * y)));
+  // the path: a quarter ellipse from the side street's left lane to the main road's, about (12, 12)
+  const P = [];
+  for (let a = 0; a <= 90; a++) { const t = ((180 + a) * Math.PI) / 180; P.push([12 + 13.5 * Math.cos(t), 12 + 10.5 * Math.sin(t)]); }
+  const z = P.map(([x, y]) => out.heightAt(x, y));
+  let worst = 0;
+  for (let i = 3; i + 3 < P.length; i++) {
+    const ds = 3 * Math.hypot(P[i + 1][0] - P[i][0], P[i + 1][1] - P[i][1]);
+    worst = Math.max(worst, Math.abs(z[i + 3] - 2 * z[i] + z[i - 3]) / (ds * ds));
+  }
+  assert.ok(worst < 0.15, `vertical curvature ${worst.toFixed(3)} per metre on the turn (radius ${(1 / worst).toFixed(1)} m)`);
