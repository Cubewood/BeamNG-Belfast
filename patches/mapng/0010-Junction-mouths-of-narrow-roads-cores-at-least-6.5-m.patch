+  for (const [x, y] of [[20, 0], [20, 2], [-20, -2]]) assert.ok(Math.abs(out.heightAt(x, y)) < 0.01, `main road at ${x},${y}: ${out.heightAt(x, y).toFixed(3)}`);
+  for (const [x, y] of [[0, 20], [2, 24], [-2, 30]]) assert.ok(Math.abs(out.heightAt(x, y) - 0.15 * y) < 0.01, `side street at ${x},${y}: ${out.heightAt(x, y).toFixed(3)}`);
