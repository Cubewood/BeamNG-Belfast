+++ b/tests/laneForkLeadIns.test.mjs
@@ -0,0 +1,63 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+import { findLaneForkLeadIns, leadInEnd, distanceToPolyline } from '../services/laneForkLeadIns.js';
+
+// heading west (-x) into a fork at (0, 0); left of travel is -y
+const westLine = (x0, x1, y = 0, n = 21) => Array.from({ length: n }, (_, i) => [x0 + ((x1 - x0) * i) / (n - 1), y]);
+const bend = (deg, len, n = 41) => Array.from({ length: n }, (_, i) => {
+  const s = (len * i) / (n - 1); const a = (deg * Math.PI) / 180;
+  return [-s * Math.cos(a), -s * Math.sin(a)];   // turned deg to the left (south) of due west
+});
+
+// A 3-lane one-way approach, its left lane into a 1-lane slip running almost straight on, the other two
+// into a 2-lane road bending right (BeamNG Belfast's Hospital Road fork, drawn from OSM)
+const approach = { oneWay: 'forward', lanes: 3, half: 4.875, shift: 0, xy: westLine(19, 0) };
+const slip = { oneWay: 'forward', lanes: 1, half: 1.7, shift: 0, xy: bend(2, 107) };
+const right = { oneWay: 'forward', lanes: 2, half: 3, shift: 0, xy: bend(-10, 90) };
+const nodesOf = (xy) => xy.map(([x, y]) => [x, y, 10, 3.4]);
+
+test('lane fork: the slip off the outer lane gets an AI lead-in, the road centred on its lanes does not', () => {
+  const leadIns = findLaneForkLeadIns([approach, slip, right]);
+  assert.deepEqual([...leadIns.keys()], [1], 'only the slip');
+  const li = leadIns.get(1);
+  assert.ok(Math.hypot(li.at[0], li.at[1]) < 1e-9, 'at the fork node');
+  assert.ok(li.minS >= approach.half + 1 - 1e-9 && li.minS >= 6, `past the approach's radius (${li.minS})`);
+  assert.ok(li.maxS <= 24 && li.maxS <= 107 / 2);
+  assert.ok(Math.abs(li.clear - (slip.half + 0.25)) < 1e-9);
+  assert.equal(li.siblings.length, 1);
+});
+
+test('lane fork: the lead-in ends at the first node past the approach that is clear of the other branch', () => {
+  const li = findLaneForkLeadIns([approach, slip, right]).get(1);
+  const nodes = nodesOf(bend(2, 40, 21));   // a node every 2 m
+  const end = leadInEnd(nodes, li);
+  assert.ok(end > 0 && end < nodes.length - 1, `an inner node (${end})`);
+  assert.ok(2 * end >= li.minS, `not inside the approach's radius (${2 * end} m)`);
+  assert.ok(distanceToPolyline(nodes[end], right.xy) > li.clear, 'clear of the other branch');
+  for (let k = 1; k < end; k++) {
+    assert.ok(2 * k < li.minS || distanceToPolyline(nodes[k], right.xy) <= li.clear, `node ${k} would have done`);
+  }
+  assert.ok(2 * end <= 12, `close to the fork (${2 * end} m)`);
+});
+
+test('lane fork: nothing where the lanes do not add up, the way is two-way, or a piece does not start at the fork', () => {
+  assert.equal(findLaneForkLeadIns([{ ...approach, lanes: 4 }, slip, right]).size, 0, 'lanes 4 != 1 + 2');
+  assert.equal(findLaneForkLeadIns([approach, { ...slip, oneWay: 'no' }, right]).size, 0, 'a two-way branch');
+  assert.equal(findLaneForkLeadIns([approach, slip, right, { oneWay: 'no', lanes: 2, half: 3, xy: [[0, 0], [0, 40]] }]).size, 0, 'a crossroads');
+  assert.equal(findLaneForkLeadIns([approach, slip]).size, 0, 'one way on is no fork');
+  assert.equal(findLaneForkLeadIns([approach, { ...slip, oneWay: 'reverse' }, right]).size, 0, 'a branch drawn against its traffic');
+  const li = findLaneForkLeadIns([approach, slip, right]).get(1);
+  assert.equal(leadInEnd(nodesOf(bend(2, 40, 21)).slice(5), li), -1, 'a later piece of the branch');
+  // a slip that stays within reach of the other branch's line all through the lead-in's range
+  assert.equal(leadInEnd(nodesOf(bend(0.5, 40, 21)), { ...li, siblings: [westLine(0, -60)] }), -1);
