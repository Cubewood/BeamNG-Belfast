diff --git a/services/laneForkLeadIns.js b/services/laneForkLeadIns.js
new file mode 100644
index 0000000..c0a208a
--- /dev/null
+++ b/services/laneForkLeadIns.js
@@ -0,0 +1,128 @@
+// Lane forks: where one one-way way splits into two or more one-way ways that
+// share its lanes out (lanes=3 into a 1-lane slip and a 2-lane road), every way
+// starts on the fork node, the centre of the wider way. BeamNG's AI holds the
+// lane it is in up to that node and then eases onto the branch's line over the
+// branch's first navgraph edge. map.lua drops every node of a straight branch
+// of one width (optimizeNodes; a decal's subdivisions are thinned by position
+// only), so that first edge can be 50 m long: a car in the outer lane of the
+// approach ran that far beside a narrow slip, its wheels off the asphalt.
+//
+// A branch whose lanes lie off its own line at the fork (so a car in them is
+// not on the branch) gets its AI path in two pieces: a short lead-in from the
+// fork, a little wider than the branch, then the rest at the branch's width.
+// The lead-in's end is an end node, so map.lua keeps it while it loads and
+// first thins the roads; the step in width keeps the two ends apart in its
+// first merge (end nodes merge there only at the same radius, within 0.1 m),
+// and once merged the node keeps its own radius, well off the fork node's. So
+// the navgraph has a node where the lead-in ends, and the AI is on the
+// branch's line there. The lead-in ends clear of the other branches (map.lua
+// merges a node lying within its radius of another road's line into that
+// road) and past the approach's own radius (the fork node takes in every node
+// within it).
+//
+// ways: [{ xy: [[x, y]...] (direction of travel for a one-way), oneWay: 'forward'|'reverse'|'no',
+//          lanes, half (driving half width), shift (the lanes' offset, left +) } | null] by index.
+// Returns Map(index -> { at: [x, y], minS, maxS, clear, siblings: [xy...] }).
+export const LANE_FORK_MEET_M = 0.75;      // ends this close are one node (shared OSM nodes can come out under different keys)
+export const LANE_FORK_CAR_HALF_M = 0.9;   // a car centred in the lanes it takes is on the branch when that centre is this far inside its edge
+export const LANE_FORK_DIR_M = 10;         // a way's heading at the fork, over its first (last) metres
+export const LANE_FORK_MIN_M = 6;          // the lead-in is at least this long ...
+export const LANE_FORK_PAST_M = 1;         // ... and ends this far past the approach's driving half width
+export const LANE_FORK_MAX_M = 24;         // never longer (nor longer than half the branch)
+export const LANE_FORK_CLEAR_M = 0.25;     // its end this far further from another branch's line than the branch's half width
+export const LANE_FORK_STEP_M = 0.15;      // the lead-in's extra half width (map.lua merges end nodes within 0.1 m of radius)
+
+const lengthOf = (xy) => xy.reduce((sum, q, i) => (i ? sum + Math.hypot(q[0] - xy[i - 1][0], q[1] - xy[i - 1][1]) : 0), 0);
+
+function pointAlong(xy, dist) {
+  let s = 0;
+  for (let i = 1; i < xy.length; i++) {
+    const L = Math.hypot(xy[i][0] - xy[i - 1][0], xy[i][1] - xy[i - 1][1]);
+    if (s + L >= dist && L > 0) {
+      const t = (dist - s) / L;
+      return [xy[i - 1][0] + t * (xy[i][0] - xy[i - 1][0]), xy[i - 1][1] + t * (xy[i][1] - xy[i - 1][1])];
+    }
+    s += L;
+  }
+  return xy[xy.length - 1];
+}
+
+export function distanceToPolyline(p, xy) {
+  let best = Infinity;
+  for (let i = 0; i + 1 < xy.length; i++) {
+    const ex = xy[i + 1][0] - xy[i][0]; const ey = xy[i + 1][1] - xy[i][1]; const L2 = ex * ex + ey * ey;
+    const t = L2 > 0 ? Math.max(0, Math.min(1, ((p[0] - xy[i][0]) * ex + (p[1] - xy[i][1]) * ey) / L2)) : 0;
+    best = Math.min(best, Math.hypot(p[0] - xy[i][0] - t * ex, p[1] - xy[i][1] - t * ey));
+  }
+  return best;
+}
+
+export function findLaneForkLeadIns(ways) {
+  const joints = [];
+  ways.forEach((w, k) => {
+    if (!w || !(w.xy?.length >= 2)) return;
+    const n = w.xy.length;
+    for (const [p, atStart] of [[w.xy[0], true], [w.xy[n - 1], false]]) {
+      let joint = joints.find((j) => Math.hypot(j.p[0] - p[0], j.p[1] - p[1]) < LANE_FORK_MEET_M);
+      if (!joint) { joint = { p, ins: [], outs: [], other: 0 }; joints.push(joint); }
+      if (w.oneWay === 'forward') (atStart ? joint.outs : joint.ins).push(k);
+      else joint.other++;
+    }
+  });
+  const out = new Map();
+  for (const j of joints) {
+    if (j.ins.length !== 1 || j.outs.length < 2 || j.other > 0) continue;
+    const parent = ways[j.ins[0]];
+    const branches = j.outs.map((k) => ({ k, w: ways[k] }));
+    if (!(parent.lanes > 0) || !(parent.half > 0) || branches.some(({ w }) => !(w.lanes > 0))) continue;
+    if (branches.reduce((sum, { w }) => sum + w.lanes, 0) !== parent.lanes) continue;
+    // the approach's heading into the fork; each branch's out of it, signed left +
+    const pLen = lengthOf(parent.xy);
+    const back = pointAlong(parent.xy, Math.max(0, pLen - LANE_FORK_DIR_M));
+    const end = parent.xy[parent.xy.length - 1];
+    const hx = end[0] - back[0]; const hy = end[1] - back[1]; const hL = Math.hypot(hx, hy);
+    if (!(hL > 0)) continue;
+    for (const b of branches) {
+      const q = pointAlong(b.w.xy, Math.min(LANE_FORK_DIR_M, lengthOf(b.w.xy)));
+      const dx = q[0] - b.w.xy[0][0]; const dy = q[1] - b.w.xy[0][1];
+      b.turn = Math.atan2(hx * dy - hy * dx, hx * dx + hy * dy);
+    }
+    branches.sort((a, b) => b.turn - a.turn);   // leftmost first
+    // the lanes each branch takes, counted from the left of the approach
+    const laneW = (2 * parent.half) / parent.lanes;
+    let taken = 0;
+    for (const b of branches) {
+      const centre = (parent.shift || 0) + parent.half - (taken + b.w.lanes / 2) * laneW;
+      taken += b.w.lanes;
+      const off = Math.abs(centre - (b.w.shift || 0));
+      if (off <= b.w.half - LANE_FORK_CAR_HALF_M) continue;
+      const maxS = Math.min(LANE_FORK_MAX_M, lengthOf(b.w.xy) / 2);
+      const minS = Math.max(LANE_FORK_MIN_M, parent.half + LANE_FORK_PAST_M);
+      if (minS > maxS) continue;
+      out.set(b.k, {
+        at: [j.p[0], j.p[1]],
+        minS,
+        maxS,
+        clear: b.w.half + LANE_FORK_CLEAR_M,
+        siblings: branches.filter((o) => o.k !== b.k).map((o) => o.w.xy),
+      });
+    }
+  }
+  return out;
+}
+
+// Where a branch's first piece ([[x, y, ...]...], from the fork) ends its
+// lead-in: the index of the first node past minS that is clear of the other
+// branches. -1 when the piece does not start at the fork or no node qualifies.
+export function leadInEnd(nodes, leadIn) {
+  if (!leadIn || !(nodes?.length >= 3)) return -1;
+  if (Math.hypot(nodes[0][0] - leadIn.at[0], nodes[0][1] - leadIn.at[1]) > LANE_FORK_MEET_M) return -1;
+  let s = 0;
+  for (let i = 1; i < nodes.length - 1; i++) {
+    s += Math.hypot(nodes[i][0] - nodes[i - 1][0], nodes[i][1] - nodes[i - 1][1]);
+    if (s > leadIn.maxS) break;
+    if (s < leadIn.minS) continue;
+    if (leadIn.siblings.every((xy) => distanceToPolyline(nodes[i], xy) > leadIn.clear)) return i;
+  }
+  return -1;
+}
