+/**
+ * Copies of the carriageways [{ owner, nodes, ... }] with their node heights
+ * from the solved profile, as applySolvedHeights sets the decals' (no deck
+ * lift); the originals are left as they are. The carriageways keep the
+ * heights they were laid out at, before the solver: curbs and walkways swept
+ * along them stood over the solved road beside them by the difference (a
+ * walkway's edge 0.4 m over a slip's asphalt, Belfast I-005).
+ */
+export function solvedCarriageways(carriageways, graph, { skipOwners = null } = {}) {
+  const copies = (carriageways || []).map((cw) => ({ ...cw, nodes: cw.nodes.map((n) => [...n]) }));
+  if (!graph?.profile?.z) return copies;
+  applySolvedHeights([{ __items: copies.map((cw) => ({ __owner: cw.owner, nodes: cw.nodes })) }], graph, { deckLift: 0, skipOwners });
+  return copies;
+}
