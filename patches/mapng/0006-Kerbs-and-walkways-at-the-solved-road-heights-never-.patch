+  }));
+  for (const c of corners) for (const p of c.arc) assert.ok(p[2] <= index(p[0], p[1]) + 1e-6, `arc at ${p.map((v) => v.toFixed(2))}`);
+});
+
+test('a curb standing on another stretch of road is no higher than that road', () => {
