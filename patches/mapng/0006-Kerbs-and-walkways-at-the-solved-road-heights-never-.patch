+/**
+ * The carriageway whose edge is nearest (x, y), within `margin` of it:
+ * { owner, z, gap } with its road height at its point nearest (x, y) and
+ * the distance out from its edge (negative on it), or null. (The first of
+ * carriagewaysAt's hits is in index order: on a street climbing past, a
+ * segment metres along it, a walkway beside the lower road took its height
+ * and stood 0.4 m over the asphalt next to it.)
+ */
+export function nearestCarriagewayAt(index, x, y, margin) {
+  const cell = index.grid.get(`${Math.floor(x / CELL_M)},${Math.floor(y / CELL_M)}`);
+  if (!cell) return null;
+  let best = null;
+  for (const idx of cell) {
+    const s = index.segments[idx];
+    const dx = s.bx - s.ax; const dy = s.by - s.ay;
+    const len = dx * dx + dy * dy;
+    const t = len > 0 ? Math.max(0, Math.min(1, ((x - s.ax) * dx + (y - s.ay) * dy) / len)) : 0;
+    const gap = Math.hypot(s.ax + t * dx - x, s.ay + t * dy - y) - halfOfSegment(s, t);
+    if (gap < margin && (!best || gap < best.gap)) best = { owner: s.owner, z: (s.az ?? 0) + ((s.bz ?? 0) - (s.az ?? 0)) * t, gap };
+  }
+  return best;
+}
