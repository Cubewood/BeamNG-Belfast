--- /dev/null
+++ b/tests/structureAdapters.test.mjs
@@ -0,0 +1,22 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+import { solvedCarriageways } from '../services/structures/adapters.js';
+
+// one road (segment 7) solved 0.1 m under the height it was laid out at
+const graph = {
+  edges: [{ seg: 7, s: [0, 10, 20], x: [0, 10, 20], y: [0, 0, 0] }],
+  profile: { z: [Float64Array.from([4.9, 5.0, 5.1])] },
+};
+
+test('carriageways for the curbs take the solved heights; the originals keep theirs', () => {
+  const cw = { owner: 7, half: 4, highway: 'residential', nodes: [[0, 0, 5, 8], [5, 0, 5.05, 8], [20, 0, 5.2, 8]] };
+  const other = { owner: 8, half: 3, nodes: [[0, 50, 9, 6], [20, 50, 9, 6]] };
+  const [solved, untouched] = solvedCarriageways([cw, other], graph);
+  assert.deepEqual(solved.nodes.map((n) => n[2]), [4.9, 4.95, 5.1], 'at the solved profile, no deck lift');
+  assert.deepEqual(cw.nodes.map((n) => n[2]), [5, 5.05, 5.2], 'the original left as it was');
+  assert.equal(solved.half, 4);
+  assert.deepEqual(untouched.nodes, other.nodes, 'a road the solver has not got keeps its heights');
+  assert.notEqual(untouched.nodes, other.nodes, 'as a copy');
+  assert.deepEqual(solvedCarriageways([cw], { edges: [] })[0].nodes, cw.nodes, 'no profile: copies as they are');
+});
