From: Cubewood <330162352+Cubewood@users.noreply.github.com>
Date: Wed, 18 Nov 2026 18:16:21 +0000
Subject: [PATCH] A side road's approach to a junction curves from the through
 road's grade across it into its own


diff --git a/services/structures/profileSolve.js b/services/structures/profileSolve.js
index 9ac7e30..8012082 100644
--- a/services/structures/profileSolve.js
+++ b/services/structures/profileSolve.js
@@ -154,6 +154,80 @@ function allowedRise(e, structure = !!(e.bridge || e.tunnel)) {
   return out;
 }
 
+// A side road's approach to a junction. A side street falling at its class
+// limit into a junction met the road it joins in a corner a few metres from
+// the node (a 6 m street: 15 % to 9 % one station out, then that road's level
+// across the mouth), and a car turning out of it took the whole change within
+// its own length. At a junction on the ground a side road (every carriageway
+// there but the through pair: the two leaving most nearly opposite, the
+// higher class first) whose ground leaves the node APPROACH_MIN steeper than
+// the through road's grade across it starts at most at that grade and
+// steepens by APPROACH_K per metre: a vertical curve of radius 1 / APPROACH_K
+// into its own grade (stations STATION_M apart: about 4 % at each). The solve
+// takes the height that gives up from the road further out; a side road too
+// short to give it keeps its allowance.
+const APPROACH_K = 0.01;
+const APPROACH_MIN = 0.06;
+const APPROACH_READ_M = 12;     // the through road's grade read this far from the node
+const NOT_CARRIAGEWAY = new Set(['footway', 'cycleway', 'path', 'pedestrian', 'steps', 'bridleway']);
+const throughRank = (h) => gradeLimit(h) + (h === 'service' || h === 'track' ? 0.1 : 0);
+function junctionApproaches(graph, stepRise) {
+  const { edges, nodes } = graph;
+  const ix = (e, end, j) => (end === 0 ? j : e.s.length - 1 - j);
+  // the direction a road leaves the node in (to its station ~8 m out)
+  const dirOf = (e, end) => {
+    const i0 = ix(e, end, 0); let j = 0;
+    while (j + 1 < e.s.length && Math.abs(e.s[ix(e, end, j)] - e.s[i0]) < 8) j++;
+    const i = ix(e, end, j); const dx = e.x[i] - e.x[i0]; const dy = e.y[i] - e.y[i0]; const l = Math.hypot(dx, dy) || 1;
+    return [dx / l, dy / l];
+  };
+  // the ground's grade leaving the node (least squares through the node's ground)
+  const groundGrade = (e, end) => {
+    const i0 = ix(e, end, 0); let sdd = 0; let sdz = 0;
+    for (let j = 1; j < e.s.length; j++) {
+      const i = ix(e, end, j); const d = Math.abs(e.s[i] - e.s[i0]);
+      if (d > APPROACH_READ_M) break;
+      if (Number.isFinite(e.g[i]) && Number.isFinite(e.g[i0])) { sdd += d * d; sdz += d * (e.g[i] - e.g[i0]); }
+    }
+    return sdd > 0 ? sdz / sdd : 0;
+  };
+  for (const node of nodes.values()) {
+    if (node.edges.length < 3 || node.edges.some(({ edge }) => edges[edge].bridge || edges[edge].tunnel || edges[edge].external)) continue;
+    const ends = node.edges.filter(({ edge }) => !NOT_CARRIAGEWAY.has(edges[edge].highway) && !graph.fixed?.[edge]?.some?.((x) => x));
+    if (ends.length < 3) continue;
+    const dirs = ends.map(({ edge, end }) => dirOf(edges[edge], end));
+    let a = -1; let b = -1; let key = Infinity;
+    for (let i = 0; i < ends.length; i++) {
+      for (let j = i + 1; j < ends.length; j++) {
+        const dot = dirs[i][0] * dirs[j][0] + dirs[i][1] * dirs[j][1];
+        if (dot > -0.5) continue;
+        const k = Math.max(throughRank(edges[ends[i].edge].highway), throughRank(edges[ends[j].edge].highway)) * 100 + dot;
+        if (k < key) { key = k; a = i; b = j; }
+      }
+    }
+    if (a < 0) continue;
+    // the through road's grade along a's direction
+    const m = (groundGrade(edges[ends[a].edge], ends[a].end) - groundGrade(edges[ends[b].edge], ends[b].end)) / 2;
+    ends.forEach(({ edge, end }, p) => {
+      if (p === a || p === b) return;
+      const e = edges[edge]; const n = e.s.length; const rise = stepRise[edge];
+      const cross = Math.abs(m * (dirs[p][0] * dirs[a][0] + dirs[p][1] * dirs[a][1]));
+      if (Math.abs(groundGrade(e, end)) - cross < APPROACH_MIN) return;
+      const s0 = e.s[ix(e, end, 0)];
+      const capped = Float64Array.from(rise);
+      for (let i = 0; i + 1 < n; i++) capped[i] = Math.min(rise[i], (cross + APPROACH_K * Math.abs((e.s[i] + e.s[i + 1]) / 2 - s0)) * (e.s[i + 1] - e.s[i]));
+      // (the rise it still allows end to end the ground's and as much again
+      // as the curve gives up: a track at its limit all the way had nowhere
+      // to take it from and lifted the junction, a hump in the road through)
+      let total = 0; let given = 0;
+      for (let i = 0; i + 1 < n; i++) { total += capped[i]; given += rise[i] - capped[i]; }
+      const g0 = e.g[0]; const g1 = e.g[n - 1];
+      if (Number.isFinite(g0) && Number.isFinite(g1) && total < Math.abs(g1 - g0) + given) return;
+      rise.set(capped);
+    });
+  }
+}
+
 // binary heap of station indices ordered by key (max-heap when sign = 1)
 function makeHeap(key, sign) {
   const a = [];
@@ -213,6 +287,7 @@ export function* solveProfilesSteps(graph) {
   // (a plain deck between held approaches, terrain shaping off, may ramp
   // this much steeper than its class: it must rise within its own length)
   const stepRise = edges.map((e, k) => (graph.noCut?.[k] ? allowedRise(e, asStructure(e)).map((r) => r * RAW_DECK_RAMP_FACTOR) : allowedRise(e, asStructure(e))));
+  junctionApproaches(graph, stepRise);
   // neighbours: along each edge (with the step's allowed rise) and between
   // the ends meeting at a node (no rise)
   const nbr = Array.from({ length: N }, () => []);
diff --git a/tests/structureProfile.test.mjs b/tests/structureProfile.test.mjs
index 9f7d72f..fda0aaf 100644
--- a/tests/structureProfile.test.mjs
+++ b/tests/structureProfile.test.mjs
@@ -331,3 +331,35 @@ test('profile: a divided road\'s two decks side by side meet at one height (no s
   assert.ok(Math.abs(z[0][50] - z[1][50]) < 0.02, `a step of ${(z[1][50] - z[0][50]).toFixed(2)} m mid-span`);
   assert.ok(Math.abs(z[0][0] - 60) < 1e-6 && Math.abs(z[1][0] - 60.6) < 1e-6, 'the ends moved');
 });
+
+test('profile: a side street steep into a junction leaves the through road at its grade across it and curves into its own', async () => {
+  const { solveProfiles } = await import('../services/structures/profileSolve.js');
+  // a level road through J (east and west) and a residential street leaving
+  // north, stations 4 m apart: its ground 12 % for 4 m, then a 31 % bank to
+  // 16 m, then level (alone, the street left J at 12 % and turned to 15 % at
+  // its first station)
+  const n = 21; const ds = 4;
+  const mk = (dx, dy, g, opts) => ({ x: Float64Array.from({ length: n }, (_, i) => i * ds * dx), y: Float64Array.from({ length: n }, (_, i) => i * ds * dy), s: Float64Array.from({ length: n }, (_, i) => i * ds), g: Float64Array.from({ length: n }, (_, i) => g(i * ds)), layer: 0, half: 3.5, bridge: false, tunnel: false, highway: 'secondary', ...opts });
+  const east = mk(1, 0, () => 10, { from: 'J', to: 'E' });
+  const west = mk(-1, 0, () => 10, { from: 'J', to: 'W' });
+  const side = mk(0, 1, (d) => (d <= 4 ? 10 + 0.12 * d : d <= 16 ? 10.48 + 0.31 * (d - 4) : 14.2), { from: 'J', to: 'S', highway: 'residential', half: 3 });
+  const nodes = new Map([['J', { edges: [{ edge: 0, end: 0 }, { edge: 1, end: 0 }, { edge: 2, end: 0 }] }], ['E', { edges: [{ edge: 0, end: 1 }] }], ['W', { edges: [{ edge: 1, end: 1 }] }], ['S', { edges: [{ edge: 2, end: 1 }] }]]);
+  const { z } = solveProfiles({ edges: [east, west, side], nodes, pins: [], crossings: { crossings: [], water: [] } });
+  const zs = z[2]; const grade = (i) => (zs[i + 1] - zs[i]) / ds;
+  assert.ok(Math.abs(grade(0)) <= 0.03, `leaves the junction at ${(grade(0) * 100).toFixed(1)} % (the road across it: 0 %)`);
+  let turn = 0; for (let i = 0; i + 1 < 4; i++) turn = Math.max(turn, Math.abs(grade(i + 1) - grade(i)));
+  assert.ok(turn <= 0.045, `grade turns ${(turn * 100).toFixed(1)} % at one station within 16 m of the junction`);
+  for (let i = 0; i + 1 < n; i++) assert.ok(Math.abs(grade(i)) <= 0.15 + 1e-6, `${(grade(i) * 100).toFixed(1)} % at ${i * ds} m`);
+  for (const k of [0, 1]) for (let i = 0; i < n; i++) assert.ok(Math.abs(z[k][i] - 10) < 0.05, `the through road stays on its ground: ${z[k][i].toFixed(2)}`);
+  assert.ok(Math.abs(z[0][0] - zs[0]) < 0.01 && Math.abs(z[1][0] - zs[0]) < 0.01, 'one height at the junction');
+});
+
+test('profile: a side street on a gentle grade into a junction keeps its own profile', async () => {
+  const { solveProfiles } = await import('../services/structures/profileSolve.js');
+  const n = 21; const ds = 4;
+  const mk = (dx, dy, g, opts) => ({ x: Float64Array.from({ length: n }, (_, i) => i * ds * dx), y: Float64Array.from({ length: n }, (_, i) => i * ds * dy), s: Float64Array.from({ length: n }, (_, i) => i * ds), g: Float64Array.from({ length: n }, (_, i) => g(i * ds)), layer: 0, half: 3.5, bridge: false, tunnel: false, highway: 'secondary', ...opts });
+  const side = mk(0, 1, (d) => 10 + 0.05 * d, { from: 'J', to: 'S', highway: 'residential', half: 3 });
+  const nodes = new Map([['J', { edges: [{ edge: 0, end: 0 }, { edge: 1, end: 0 }, { edge: 2, end: 0 }] }], ['E', { edges: [{ edge: 0, end: 1 }] }], ['W', { edges: [{ edge: 1, end: 1 }] }], ['S', { edges: [{ edge: 2, end: 1 }] }]]);
+  const { z } = solveProfiles({ edges: [mk(1, 0, () => 10, { from: 'J', to: 'E' }), mk(-1, 0, () => 10, { from: 'J', to: 'W' }), side], nodes, pins: [], crossings: { crossings: [], water: [] } });
+  for (let i = 0; i < n; i++) assert.ok(Math.abs(z[2][i] - side.g[i]) < 0.01, `on its ground at ${i * ds} m: ${z[2][i].toFixed(2)} for ${side.g[i].toFixed(2)}`);
+});
