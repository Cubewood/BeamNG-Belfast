+// belfast patch (T-412): the lanes are subtracted from the footprint locally
+test('the cut is local: a road ending at a corner of a huge footprint takes only that corner', () => {
+  // a 100 x 100 m block; a street running up at 45 degrees to end at (0, 0), 0.7 m from the block's corner.
+  // A straight cut along the street's line would keep only the half of the block on one side of it
+  const road = { id: 'way_diag', type: 'road', tags: { highway: 'service' }, geometry: [P(-60, -60), P(0, 0)] };
+  const block = { id: 'way_big', type: 'building', tags: { building: 'retail' }, geometry: rect(1, -5, 101, 95) };
+  const r = run([road, block]);
+  assert.equal(r.flagged.length, 0, 'not left as mapped');
+  assert.equal(r.clipped.length, 1);
+  assert.ok(r.clipped[0].local && r.clipped[0].kept > 0.99, `kept ${r.clipped[0].kept}`);
+  const cut = r.features.find((f) => f.id === 'way_big');
+  const pts = cut.geometry.map((p) => project(p.lat, p.lng));
+  assert.ok(pts.some(([x, y]) => Math.abs(x - 101) < 1e-6 && Math.abs(y - 95) < 1e-6), 'the far corner stays');
+  assert.ok(pts.some(([x, y]) => Math.abs(x - 101) < 1e-6 && Math.abs(y + 5) < 1e-6), 'the corner at the other end stays');
+  // nothing of the cut footprint is inside the street's lanes (half width 1.8 + 0.3 + the 0.3 kerb allowance, minus polygon slack)
+  const half = 2.1;
+  for (const [x, y] of pts) {
+    const t = Math.max(0, Math.min(1, (x + 60 + y + 60) / 120));   // nearest point on (-60,-60)-(0,0)
+    const d = Math.hypot(x - (-60 + 60 * t), y - (-60 + 60 * t));
+    assert.ok(d >= half - 0.1, `vertex (${x.toFixed(2)}, ${y.toFixed(2)}) is ${d.toFixed(2)} m from the street`);
+  }
+});
+
+test('a road running through a large footprint is a passage or a misplaced line: kept as mapped and listed, not carved', () => {
+  // 30 x 41 m site with the street through it: 10% of it on the lanes, 30 m of centre line inside
+  const site = { id: 'way_site', type: 'building', tags: { building: 'construction' }, geometry: rect(-15, -1, 15, 40) };
+  const r = run([street(), site]);
+  assert.equal(r.clipped.length, 0);
+  assert.deepEqual(r.flagged.map((d) => d.id), ['way_site']);
+  assert.ok(r.features.includes(site));
+});
