 const SAMPLE_MIN_M = 0.5;
 const CELL_M = 24;               // road segment index cell
 const MAX_CUTS = 3;
+const PASSAGE_RUN_M = 5;         // belfast patch (T-412): a centre line this far through an OSM footprint is not a cut-back case
+const CAP_STEPS = 8;             // arc segments per half circle of a lane strip's end
 
 const SKIP_SERVICE = new Set(['driveway', 'parking_aisle', 'drive-through']);
 const ROAD_SKIP = new Set([...NON_DRIVEABLE_HIGHWAYS, 'raceway', 'platform', 'bus_stop', 'elevator', 'services', 'rest_area']);
@@ -128,6 +134,30 @@ function clipHalfPlane(ring, p, n) {
   return out;
 }
 
+// belfast patch (T-412): a road segment's lanes as a polygon: the segment
+// widened by `half` each side, with a round end at each of its two nodes (so
+// consecutive segments of a bend leave no gap)
+function laneStrip(s) {
+  const ang = Math.atan2(s.b[1] - s.a[1], s.b[0] - s.a[0]);
+  const ring = [];
+  for (let i = 0; i <= CAP_STEPS; i++) { const t = ang - Math.PI / 2 + (Math.PI * i) / CAP_STEPS; ring.push([s.b[0] + Math.cos(t) * s.half, s.b[1] + Math.sin(t) * s.half]); }
+  for (let i = 0; i <= CAP_STEPS; i++) { const t = ang + Math.PI / 2 + (Math.PI * i) / CAP_STEPS; ring.push([s.a[0] + Math.cos(t) * s.half, s.a[1] + Math.sin(t) * s.half]); }
+  return ring;
+}
+
+// the footprint `ring` with the lanes of `segs` taken out, as one ring, or null
+// when that leaves nothing, several pieces or a hole (or the clipper gives up)
+function cutOutLanes(ring, segs) {
+  try {
+    const res = polygonClipping.difference([ring], ...segs.map((s) => [laneStrip(s)]));
+    if (res.length !== 1 || res[0].length !== 1) return null;
+    const out = res[0][0].slice(0, -1);
+    return out.length >= 3 ? out : null;
+  } catch (e) {
+    return null;
+  }
+}
