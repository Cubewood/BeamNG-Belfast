+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+import { generateDecalRoads, generateJunctionMarkingDecals } from '../services/exportBeamNGLevel.js';
+import { buildSidewalkMeshes } from '../services/beamngSidewalks.js';
+import { buildRoadGraph, findSignalApproaches, makeProjector } from '../services/signalApproaches.js';
+import {
+  impliedGiveWays, junctionArmsAll, lineSpan, priorityAtJunction, UK_CORNER_RADII,
+} from '../services/ukJunctions.js';
+
+const GB = { countryCode: 'GB', countryName: 'United Kingdom', region: 'Europe', leftHandTraffic: true };
+const IE = { countryCode: 'IE', countryName: 'Ireland', region: 'Europe', leftHandTraffic: true };
+const J = 0.005;
+const M = 111320;   // metres per degree in the projector at latitude ~0
+// a way from metre offsets around (J, J)
+const way = (id, tags, pts) => ({ id, type: 'road', tags: { name: id, ...tags }, geometry: pts.map(([x, y]) => ({ lat: J + y / M, lng: J + x / M })) });
+const graphOf = (roads) => buildRoadGraph(roads, makeProjector(J, J));
+const nodeAt = (graph, x = 0, y = 0) => [...graph.nodes.values()].find((n) => Math.hypot(n.x - x, n.y - y) < 0.01);
+const rule = (roads) => { const g = graphOf(roads); return priorityAtJunction(junctionArmsAll(nodeAt(g))); };
+const names = (arms) => arms.map((a) => a.road.id).sort();
+
+test('the priority road: higher class first, then the road carrying on, then the straightest pair', () => {
+  // a residential stem onto a secondary: the stem gives way
+  let r = rule([way('main', { highway: 'secondary' }, [[-100, 0], [0, 0], [100, 0]]), way('side', { highway: 'residential' }, [[0, -100], [0, 0]])]);
+  assert.deepEqual(names(r.giveWay), ['side']);
+  // three residential arms, two of one street: the other street gives way
+  r = rule([way('Grays Park', { highway: 'residential' }, [[-100, 0], [0, 0], [100, 10]]), way('Avenue', { highway: 'residential' }, [[0, 0], [60, -80]])]);
+  assert.deepEqual(names(r.giveWay), ['Avenue']);
+  // one street, three arms: the arm off the straight line gives way
+  r = rule([way('Close', { highway: 'residential' }, [[-100, 0], [0, 0], [100, 5]]), { ...way('Close', { highway: 'residential' }, [[0, 0], [0, -80]]), id: 'Close stem' }]);
+  assert.deepEqual(names(r.giveWay), ['Close stem']);
+  // the main road turns the corner: class beats straightness
+  r = rule([way('main', { highway: 'tertiary' }, [[-100, 0], [0, 0], [0, 100]]), way('lane', { highway: 'residential' }, [[0, 0], [100, 0]])]);
+  assert.deepEqual(names(r.giveWay), ['lane']);
+  // a crossroads: both minor arms
+  r = rule([way('main', { highway: 'secondary' }, [[-100, 0], [0, 0], [100, 0]]), way('side', { highway: 'residential' }, [[0, -100], [0, 0], [0, 100]])]);
+  assert.equal(r.giveWay.length, 2);
+  assert.ok(r.giveWay.every((a) => a.road.id === 'side'));
+});
+
+test('no Give Way where a dual carriageway starts, where a one-way road leaves or merges at a shallow angle', () => {
+  // two-way road splitting into its two one-way carriageways
+  let r = rule([
+    way('Milltown Road', { highway: 'trunk' }, [[-100, 0], [0, 0]]),
+    { ...way('Milltown Road', { highway: 'trunk', oneway: 'yes' }, [[0, 0], [100, 8]]), id: 'out' },
+    { ...way('Milltown Road', { highway: 'trunk', oneway: 'yes' }, [[100, -8], [0, 0]]), id: 'in' },
+  ]);
+  assert.equal(r.giveWay.length, 0);
+  // a one-way slip merging at 10 degrees into a one-way road
+  r = rule([
+    way('Belvoir Road', { highway: 'trunk', oneway: 'yes' }, [[-100, 0], [0, 0], [100, 0]]),
+    way('slip', { highway: 'trunk_link', oneway: 'yes' }, [[-100, -17.6], [0, 0]]),
+  ]);
+  assert.equal(r.giveWay.length, 0);
+  // the same slip at 45 degrees gives way; a slip leaving never does
+  r = rule([
+    way('Belvoir Road', { highway: 'trunk', oneway: 'yes' }, [[-100, 0], [0, 0], [100, 0]]),
+    way('slip', { highway: 'secondary_link', oneway: 'yes' }, [[-70, -70], [0, 0]]),
+  ]);
+  assert.deepEqual(names(r.giveWay), ['slip']);
+  r = rule([
+    way('Belvoir Road', { highway: 'trunk', oneway: 'yes' }, [[-100, 0], [0, 0], [100, 0]]),
+    way('exit', { highway: 'secondary_link', oneway: 'yes' }, [[0, 0], [70, -70]]),
+  ]);
+  assert.equal(r.giveWay.length, 0);
+});
+
+test('a roundabout: the ring has priority, every entry gives way', () => {
+  const ring = way('ring', { highway: 'tertiary', junction: 'roundabout' }, [[11, 0], [0, -11], [-11, 0], [0, 11], [11, 0]]);
+  const entry = way('entry', { highway: 'residential' }, [[-60, 0], [-11, 0]]);
+  const g = graphOf([ring, entry]);
+  const r = priorityAtJunction(junctionArmsAll(nodeAt(g, -11, 0)));
+  assert.equal(r.roundabout, true);
+  assert.deepEqual(names(r.giveWay), ['entry']);
+  assert.ok(r.priority.every((a) => a.road.id === 'ring'));
+});
+
+test('implied Give Ways: only where OSM maps none, never at signals, and OSM wins where it disagrees', () => {
+  const roads = [way('main', { highway: 'secondary' }, [[-100, 0], [0, 0], [100, 0]]), way('side', { highway: 'residential' }, [[0, -100], [0, 0]])];
+  const projector = makeProjector(J, J);
+  const at = (x, y) => ({ point: { lat: J + y / M, lng: J + x / M }, tags: {} });
+  let j = findSignalApproaches({ roads, projector });
+  let implied = impliedGiveWays(j);
+  assert.equal(implied.length, 1);
+  assert.equal(implied[0].road.id, 'side');
+  assert.ok(implied[0].ukImplied && !implied[0].ukRoundabout);
+  // OSM maps the give-way on the side road: that one stands, nothing added
+  j = findSignalApproaches({ roads, projector, yieldPoints: [at(0, -5)] });
+  assert.equal(j.yieldApproaches.length, 1);
+  assert.equal(impliedGiveWays(j).length, 0);
+  // OSM maps a give-way on the main road's arm: left as OSM has it
+  j = findSignalApproaches({ roads, projector, yieldPoints: [at(-5, 0)] });
+  assert.equal(impliedGiveWays(j).length, 0);
+  // signals at the junction
+  j = findSignalApproaches({ roads, projector, signalPoints: [at(0, 0)] });
+  assert.equal(impliedGiveWays(j).length, 0);
+});
+
+test('line span: kerb to centre line, the full width on a one-way road or under 2.75 m, centre moved by uneven lanes', () => {
+  const two = { oneWay: false, road: { tags: {} } };
+  assert.deepEqual(lineSpan(two, 5.3, true), { from: 0.25, to: 5, laneFrom: 0.25, centre: 0, full: false });
+  const narrow = lineSpan(two, 2.6, true);
+  assert.ok(narrow.full && Math.abs(narrow.from + 2.3) < 1e-9 && Math.abs(narrow.to - 2.3) < 1e-9, 'kerb to centre 2.6 m: full width');
+  assert.equal(lineSpan(two, 2.6, true, { fullWidthUnder: 0 }).full, false, 'signal Stop lines keep kerb to centre');
+  assert.deepEqual(lineSpan({ oneWay: true }, 4, true), { from: -3.7, to: 3.7, laneFrom: -3.7, centre: -3.7, full: true });
+  // three of four lanes ours (lanes:forward 3, arriving along node order): the centre line 0.5 E past the axis
+  const uneven = lineSpan({ oneWay: false, road: { tags: { 'lanes:forward': '3', 'lanes:backward': '1' } } }, 7, true);
+  assert.ok(Math.abs(uneven.centre + 3.35) < 1e-9 && Math.abs(uneven.from + 3.1) < 1e-9, JSON.stringify(uneven));
+});
+
+// T junction in a 1.1 km box: the secondary `main` runs east-west through J,
+// the tertiary `side` comes up from the south and stops at it (as tests/ukRoadMarkings.test.mjs).
+function tJunction(roadRules, sideTags = {}, extra = []) {
+  const size = 64;
+  const road = (id, tags, coords) => ({ id, type: 'road', tags: { name: id, ...tags }, geometry: coords.map(([lat, lng]) => ({ lat, lng })) });
+  return {
+    width: size, height: size, minHeight: 0, maxHeight: 50,
+    heightMap: new Float32Array(size * size).fill(10),
+    bounds: { north: 0.01, south: 0, west: 0, east: 0.01 },
+    metersPerPixel: (0.01 * 111320) / size,
+    roadRules,
+    osmFeatures: [
+      road('main', { highway: 'secondary', maxspeed: '40 mph' }, [[J, 0.001], [J, J], [J, 0.009]]),
+      road('side', { highway: 'tertiary', maxspeed: '30 mph', ...sideTags }, [[0.001, J], [J - 0.0002, J], [J, J]]),
+      ...extra,
+    ],
+  };
+}
+const allDecals = (groups) => {
+  const out = [];
+  const walk = (items) => items.forEach((it) => { if (it.class === 'DecalRoad') out.push(it); if (it.__items) walk(it.__items); });
+  walk(groups);
+  return out;
+};
+
+test('a UK side road with no give-way node gets its Give Way line at the mouth, square, kerb to centre, with 1009A', () => {
+  const td = tJunction(GB);
+  const decals = allDecals(generateDecalRoads(td, td.metersPerPixel));
+  const mainBody = decals.find((d) => /^dr_main_.*_b$/.test(d.name));
+  const sideBody = decals.find((d) => /^dr_side_.*_b$/.test(d.name));
+  assert.ok(mainBody && sideBody);
+  const mainHalf = mainBody.nodes[0][3] / 2; const sideHalf = sideBody.nodes[0][3] / 2;
+  const [line] = decals.filter((d) => /^jm_giveway_\d/.test(d.name));
+  assert.ok(line, 'an implied Give Way line');
+  assert.equal(line.material, 'uk_giveway_1003a_cubewood');
+  // square: across the side road (it runs north-south)
+  assert.ok(Math.abs(line.nodes[0][1] - line.nodes[1][1]) < 1e-3, 'runs east-west, square to the side road');
+  // at the mouth: the near (north) edge 0.1 m off the main road's kerb (y = -mainHalf)
+  const nearEdge = line.nodes[0][1] + 0.35;
+  assert.ok(Math.abs(nearEdge - (-mainHalf - 0.1)) <= 0.11, `near edge at ${nearEdge.toFixed(2)}, kerb at ${-mainHalf}`);
+  // kerb to centre on the left (west) half, 0.3 m inside the kerb, 0.25 m off the centre line
+  const xs = line.nodes.map((n) => n[0]).sort((a, b) => a - b);
+  assert.ok(Math.abs(xs[0] + (sideHalf - 0.3)) < 0.05 && Math.abs(xs[1] + 0.25) < 0.05, `x ${xs}`);
+  const [edge] = decals.filter((d) => d.name.startsWith('jm_edge_1009a'));
+  assert.ok(edge && edge.material === 'uk_dash_600_300_cubewood', '1009A across the exit half');
+  assert.ok(edge.nodes.every(([x]) => x > 0), 'on the east half');
+  const tri = decals.filter((d) => d.name.startsWith('jm_giveway_triangle'));
+  assert.equal(tri.length, 1);
+  assert.ok(tri[0].nodes.every(([, y]) => y < line.nodes[0][1]), 'the triangle behind the line');
+  // Ireland: nothing
+  const ie = allDecals(generateDecalRoads(tJunction(IE), td.metersPerPixel));
+  assert.equal(ie.filter((d) => d.name.startsWith('jm_giveway')).length, 0);
+});
+
+test('a side road bending away just past its mouth still gets its line; a dual carriageway gap gets none', () => {
+  const g = (x, y) => ({ lat: J + y / M, lng: J + x / M });
+  const road = (id, tags, pts) => ({ id, type: 'road', tags: { name: id, ...tags }, geometry: pts.map(([x, y]) => g(x, y)) });
+  const base = tJunction(GB);
+  // a side road from the south that turns west 9 m from the main road's centreline
+  const bent = { ...base, osmFeatures: [road('main', { highway: 'secondary' }, [[-300, 0], [0, 0], [300, 0]]), road('side', { highway: 'residential' }, [[-200, -9], [-12, -9], [0, 0]])] };
+  const lines = allDecals(generateDecalRoads(bent, bent.metersPerPixel)).filter((d) => /^jm_giveway_\d/.test(d.name));
+  assert.equal(lines.length, 1, 'the bend does not count as a road it meets');
+  // one way that comes back to meet itself (a crescent): its arm off the straight line still meets the rest of it
+  const loop = { ...base, osmFeatures: [road('Crescent', { highway: 'residential' }, [[0, -150], [0, 0], [80, 0], [80, 80], [0, 80], [0, 0]])] };
+  const ll = allDecals(generateDecalRoads(loop, loop.metersPerPixel)).filter((d) => /^jm_giveway_\d/.test(d.name));
+  assert.equal(ll.length, 1, 'one line, on the arm off the straight');
+  assert.ok(ll[0].nodes.every(([x]) => x > 3), `on the east arm (${ll[0].nodes.map((n) => n[0].toFixed(1))})`);
+  // a residential road crossing a dual carriageway whose two carriageways are 14 m apart: lines outside, none in the gap
+  const dual = {
+    ...base,
+    osmFeatures: [
+      road('north', { highway: 'trunk', oneway: 'yes' }, [[300, 7], [0, 7], [-300, 7]]),
+      road('south', { highway: 'trunk', oneway: 'yes' }, [[-300, -7], [0, -7], [300, -7]]),
+      road('cross', { highway: 'residential' }, [[0, -150], [0, -7], [0, 7], [0, 150]]),
+    ],
+  };
+  const dl = allDecals(generateDecalRoads(dual, dual.metersPerPixel)).filter((d) => /^jm_giveway_\d/.test(d.name));
+  assert.equal(dl.length, 2, `two lines, the outer arms (${dl.map((d) => d.nodes[0][1].toFixed(1))})`);
+  assert.ok(dl.every((d) => Math.abs(d.nodes[0][1]) > 7), 'none between the carriageways');
+});
