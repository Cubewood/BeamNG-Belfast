diff --git a/services/ukJunctions.js b/services/ukJunctions.js
new file mode 100644
index 0000000..e95038d
--- /dev/null
+++ b/services/ukJunctions.js
@@ -0,0 +1,281 @@
+// UK priority junctions and roundabouts, for a level whose road rules are the
+// United Kingdom's (ukRoadMarkings.isUkRoadRules):
+//   impliedGiveWays  the minor arms of a junction that OSM maps no give-way
+//                    or stop node for: the arm that gives way is decided by
+//                    road class, then by the road carrying on through
+//                    (name or ref), then by the straightest pair of arms;
+//                    every entry onto a roundabout gives way to the ring.
+//   junctionMouth    where a Give Way or Stop line goes on its approach:
+//                    square to the minor road, the line's edge nearest the
+//                    junction on the edge of the road it meets ("the line
+//                    edge nearest the major road continues the major road
+//                    edge", TSM 3 2.3.1 to 2.3.4, Figure 2-5; 1003A and
+//                    1003.1 are sited the same way, TSM 3 3.2.1, TSM 5 6.2.1).
+//   lineSpan         across which part of the approach a line runs: kerb to
+//                    centre line on a two-way road (the centre line where
+//                    lanes:forward and lanes:backward put it), the full width
+//                    on a one-way road, or where kerb to centre is under
+//                    2.75 m (TSM 3 2.3.2).
+//   UK_CORNER_RADII  kerb return radius at a junction corner by the larger
+//                    road's class (Creating Places, DOE NI 2000, Table 4 and
+//                    para 16.27: 6 m between access roads, 4 m where the minor
+//                    road serves about 50 dwellings or for shared surfaces,
+//                    10 m at junctions with local distributor roads).
+// Works in the stop-bar pass's frames: the junction graph's projector metres
+// for the arms, the world frame for the drawn carriageways.
+import {
+  approachFromArm, armStopDistance, canArrive, canLeave, isJunction, junctionArms, otherEnd, pointAlong, roadHalfWidth, roadRank, walk,
+} from './signalApproaches.js';
+import { crossingCarriagewaysAt, parallelHalfWidthAt } from './roadMarkingCuts.js';
+
+// residential and unclassified streets 6 m, shared surfaces 4 m, distributor
+// roads 10 m (Creating Places names no larger radius; trunk roads take it too).
+// Service roads and tracks keep MapNG's own.
+export const UK_CORNER_RADII = Object.freeze({
+  residential: 6, unclassified: 6, road: 6, living_street: 4,
+  tertiary: 10, tertiary_link: 10, secondary: 10, secondary_link: 10,
+  primary: 10, primary_link: 10, trunk: 10, trunk_link: 10,
+});
+
+// service roads (rank 1) and tracks (0): neither given a line nor counted for
+// priority (driveways, car parks and private accesses: TSM 3 gives them the
+// 1009A edge line of the road they leave, not a Give Way line)
+export const MIN_PUBLIC_RANK = 2;
+// an inbound one-way arm this close in direction to the priority road's
+// inbound arm merges with it (a taper, not a priority junction)
+const MERGE_DEG = 35;
+// the arm's direction is read this far out from the node (a kink at the node
+// does not count)
+const ARM_DIRECTION_M = 5;
+
+const norm = (v) => String(v ?? '').trim().toLowerCase();
+export const isRoundaboutRoad = (tags = {}) => ['roundabout', 'circular'].includes(norm(tags.junction));
+const roadIdentity = (road) => norm(road?.tags?.name) || norm(road?.tags?.ref) || `way ${String(road?.id ?? '').split('_seg')[0]}`;
+const unit = (x, y) => { const l = Math.hypot(x, y) || 1; return [x / l, y / l]; };
+
+/** Every arm of a junction node that a public road makes: direction, class, which way traffic may run. */
+export function junctionArmsAll(node) {
+  const out = [];
+  for (const edge of node.edges) {
+    const road = edge.road;
+    const rank = roadRank(road?.tags?.highway);
+    if (rank < MIN_PUBLIC_RANK) continue;
+    const path = walk(node, edge, ARM_DIRECTION_M + 1, () => false);
+    const at = pointAlong(path, Math.min(ARM_DIRECTION_M, path.length));
+    const u = at ? unit(at.x - node.x, at.y - node.y) : unit(otherEnd(edge, node).x - node.x, otherEnd(edge, node).y - node.y);
+    out.push({
+      edge, road, rank, id: roadIdentity(road), u,
+      armId: `${node.key}|${otherEnd(edge, node).key}`,
+      inbound: canArrive(edge, node), outbound: canLeave(edge, node), twoWay: edge.fwd && edge.back,
+      ring: isRoundaboutRoad(road?.tags),
+    });
+  }
+  return out;
+}
+
+const better = (a, b) => {
+  for (let i = 0; i < a.length; i++) if (a[i] !== b[i]) return a[i] > b[i];
+  return false;
+};
+
+/**
+ * The inbound arms of one junction that give way, from junctionArmsAll.
+ * Roundabout: every entry (the ring has priority). Otherwise the priority
+ * road is the pair of arms traffic can run through with the highest class,
+ * the same road (name or ref) before different ones, then the straightest;
+ * the other inbound arms give way, except the priority road's other
+ * carriageway where a dual carriageway starts (same road, one-way, the pair
+ * holds its two-way end) and an arm merging at under MERGE_DEG.
+ * Returns { giveWay: [arms], priority: [arms] } or null (fewer than 3 arms).
+ */
+export function priorityAtJunction(arms) {
+  if (arms.length < 3) return null;
+  if (arms.some((a) => a.ring)) {
+    const priority = arms.filter((a) => a.ring);
+    return { priority, giveWay: arms.filter((a) => !a.ring && a.inbound), roundabout: true };
+  }
+  let best = null;
+  for (let i = 0; i < arms.length; i++) {
+    for (let j = i + 1; j < arms.length; j++) {
+      const a = arms[i]; const b = arms[j];
+      if (!((a.inbound && b.outbound) || (b.inbound && a.outbound))) continue;
+      const key = [Math.min(a.rank, b.rank), a.id === b.id ? 1 : 0, -(a.u[0] * b.u[0] + a.u[1] * b.u[1])];
+      if (!best || better(key, best.key)) best = { key, pair: [a, b] };
+    }
+  }
+  if (!best) return null;
+  const [a, b] = best.pair;
+  const into = [a, b].filter((x) => x.inbound);
+  const mergeCos = Math.cos((MERGE_DEG * Math.PI) / 180);
+  const giveWay = arms.filter((x) => {
+    if (x === a || x === b || !x.inbound) return false;
+    if (!x.twoWay && x.id === a.id && x.id === b.id && x.rank === best.key[0] && (a.twoWay || b.twoWay)) return false;
+    if (!x.twoWay && into.some((p) => p.u[0] * x.u[0] + p.u[1] * x.u[1] > mergeCos)) return false;
+    return true;
+  });
+  return { priority: [a, b], giveWay, roundabout: false };
+}
+
+/**
+ * Give-way approaches (signalApproaches.approachFromArm) for the minor arms of
+ * every junction OSM maps no control for. Signalled junctions and
+ * mini-roundabouts are left alone; a junction where OSM maps a give-way or
+ * stop on an arm this rule gives priority is left as OSM has it. An arm OSM
+ * already controls keeps its own approach. Each approach gets `ukImplied`.
+ */
+export function impliedGiveWays(junctions, { miniRoundabouts = null } = {}) {
+  const graph = junctions?.graph;
+  if (!graph) return [];
+  const signalled = new Set((junctions.intersections || []).filter((i) => !i.midblock).flatMap((i) => i.approaches.map((a) => a.junctionKey)));
+  const controlled = new Set([...(junctions.stopApproaches || []), ...(junctions.yieldApproaches || [])].map((a) => a.armId));
+  const out = [];
+  for (const node of graph.nodes.values()) {
+    if (!isJunction(node) || signalled.has(node.key) || miniRoundabouts?.has(node.key)) continue;
+    const arms = junctionArmsAll(node);
+    const rule = priorityAtJunction(arms);
+    if (!rule?.giveWay.length) continue;
+    const minor = new Set(rule.giveWay.map((a) => a.armId));
+    if (arms.some((a) => controlled.has(a.armId) && !minor.has(a.armId))) continue;
+    const inbound = junctionArms(node, new Set([node.key]));
+    for (const arm of inbound) {
+      if (!minor.has(arm.armId) || controlled.has(arm.armId)) continue;
+      const approach = approachFromArm(arm, armStopDistance(arm, inbound, junctions.crossingKeys));
+      if (approach) out.push(Object.assign(approach, { ukImplied: true, ukRoundabout: rule.roundabout }));
+    }
+  }
+  return out;
+}
+
+// MapNG's own inset: paint stops this far inside the drawn carriageway's edge
+// (exportBeamNGLevel JUNCTION_MARK_EDGE_INSET_M)
+export const EDGE_INSET_M = 0.3;
+// the gap left at the centre line on a two-way road (STOP_BAR_CENTRE_GAP_M)
+export const CENTRE_GAP_M = 0.25;
+// kerb to centre line under this: the line runs across the full width (TSM 3 2.3.2)
+const FULL_WIDTH_UNDER_M = 2.75;
+
+const lanesTag = (tags, key) => { const n = Number.parseInt(tags?.[key], 10); return Number.isFinite(n) && n > 0 ? n : 0; };
+
+/** The approach's arm in the junction graph: { node, edge, along } (along: traffic arrives along node order), or null. */
+export function approachArm(approach, graph) {
+  const node = graph?.nodes?.get(approach?.junctionKey);
+  const nextKey = String(approach?.armId ?? '').split('|')[1];
+  const edge = node?.edges?.find((e) => otherEnd(e, node).key === nextKey);
+  return edge ? { node, edge, along: edge.to === node } : null;
+}
+
+/**
+ * The lateral span of a transverse line on an approach whose drawn half
+ * width is `half`, measured from the centreline towards the kerb (left in
+ * left-hand traffic): { from, to, laneFrom, centre, full }. `laneFrom` is
+ * where the approach's own lanes start (the triangles' lanes); `along`
+ * (approachArm) says which of lanes:forward / lanes:backward are its own.
+ */
+export function lineSpan(approach, half, along, { fullWidthUnder = FULL_WIDTH_UNDER_M } = {}) {
+  const E = Math.max(1, half - EDGE_INSET_M);
+  if (approach.oneWay) return { from: -E, to: E, laneFrom: -E, centre: -E, full: true };
+  // where the centre line runs: lanes:forward / lanes:backward split the road unevenly (ukLineLayers mirrors it)
+  const tags = approach.road?.tags || {};
+  const fwd = lanesTag(tags, 'lanes:forward'); const back = lanesTag(tags, 'lanes:backward');
+  const lanesIn = along === undefined || along === null ? 0 : (along ? fwd : back);
+  const lanesOut = along === undefined || along === null ? 0 : (along ? back : fwd);
+  const centre = lanesIn && lanesOut ? E * (1 - (2 * lanesIn) / (lanesIn + lanesOut)) : 0;
+  if (half - centre < fullWidthUnder) return { from: -E, to: E, laneFrom: centre + CENTRE_GAP_M, centre, full: true };
+  return { from: centre + CENTRE_GAP_M, to: E, laneFrom: centre + CENTRE_GAP_M, centre, full: false };
+}
+
+const MOUTH_STEP_M = 0.1;
+const MOUTH_MAX_M = 30;
+// the line's near edge stays this far off the carriageway it meets
+const MOUTH_CLEAR_M = 0.1;
+const MOUTH_SAMPLES = 6;
+
+/**
+ * Where a transverse line `nearEdgeM` (its half painted width) goes on an
+ * approach: walking out along the arm from the junction node, the first spot
+ * where the line, across its whole span, is clear of every carriageway that
+ * crosses the arm. Returns { found: true, px, py, dir, kerb, half, span, d,
+ * armLength } in the world frame (dir: travel, kerb: left of travel), or
+ * { found: false, reason }: 'merge' where no carriageway crosses the arm at
+ * the node (a shallow merge), 'no-room' where none clears within the arm (a
+ * short link inside a junction, the gap of a dual carriageway). null without
+ * the graph or the carriageways.
+ *   context: { junctions, toWorld(x, y) -> [wx, wy], carriageways (roadMarkingCuts index) }
+ */
+export function junctionMouth(approach, context, nearEdgeM) {
+  const { junctions, toWorld, carriageways } = context || {};
+  const arm = approachArm(approach, junctions?.graph);
+  if (!arm || !toWorld || !carriageways) return null;
+  const { node, edge, along } = arm;
+  const path = walk(node, edge, MOUTH_MAX_M + 10);
+  const maxD = Math.min(MOUTH_MAX_M, path.length - 0.5);
+  const frameAt = (d) => {
+    const at = pointAlong(path, d);
+    if (!at) return null;
+    const p = toWorld(at.x, at.y);
+    const q = toWorld(at.x - at.outward[0], at.y - at.outward[1]);
+    const dir = unit(q[0] - p[0], q[1] - p[1]);
+    return { p, dir, kerb: [-dir[1], dir[0]] };
+  };
+  // the arm's own carriageway (a bend in it runs across its line further on) is never what it meets: a
+  // segment lying along the arm, both its ends within OWN_NEAR_M of it (not by owner: a way that loops
+  // back to meet itself is one owner)
+  const armPts = [];
+  for (let d = 0; d <= path.length + 1e-9; d += OWN_STEP_M) { const f = frameAt(Math.min(d, path.length)); if (f) armPts.push(f.p); }
+  // (near the arm, and past its first metres: the road it meets crosses the arm at the node)
+  const nearArm = (x, y) => {
+    let best = Infinity; let arc = 0;
+    for (let i = 0; i + 1 < armPts.length; i++) {
+      const [ax, ay] = armPts[i]; const [bx, by] = armPts[i + 1];
+      const vx = bx - ax; const vy = by - ay; const L2 = vx * vx + vy * vy || 1e-9;
+      const t = Math.max(0, Math.min(1, ((x - ax) * vx + (y - ay) * vy) / L2));
+      const dist = Math.hypot(ax + vx * t - x, ay + vy * t - y);
+      if (dist < best) { best = dist; arc = (i + t) * OWN_STEP_M; }
+    }
+    return best <= OWN_NEAR_M && arc >= OWN_FROM_M;
+  };
+  const alongArm = (s) => nearArm(s.ax, s.ay) && nearArm(s.bx, s.by);
+  const onCrossing = (x, y, margin, dir) => crossingCarriagewaysAt(carriageways, x, y, margin, dir).some((s) => !alongArm(s));
+  for (let d = MOUTH_STEP_M; d <= maxD + 1e-9; d += MOUTH_STEP_M) {
+    const f = frameAt(d);
+    if (!f) break;
+    const { p, dir, kerb } = f;
+    const half = parallelHalfWidthAt(carriageways, p[0], p[1], dir) ?? approach.halfWidth;
+    const span = lineSpan(approach, half, along);
+    const lateral = (k) => span.from + ((span.to - span.from) * k) / (MOUTH_SAMPLES - 1);
+    let blocked = false;
+    for (let k = 0; k < MOUTH_SAMPLES && !blocked; k++) {
+      blocked = onCrossing(p[0] + kerb[0] * lateral(k) + dir[0] * nearEdgeM, p[1] + kerb[1] * lateral(k) + dir[1] * nearEdgeM, MOUTH_CLEAR_M, dir);
+    }
