+test('UK kerb radii at junction corners (Creating Places): 6 m between residential streets, 10 m with a distributor road', () => {
+  const street = (o) => ({ owner: 1, half: 4, highway: 'residential', urban: true, tags: { sidewalk: 'both' }, continuations: [], ...o });
+  const ew = street({ owner: 1, nodes: [[-100, 0, 5, 8], [0, 0, 5, 8], [100, 0, 5, 8]] });
+  const ns = street({ owner: 2, tags: { sidewalk: 'both', name: 'Cross' }, nodes: [[0, -100, 5, 8], [0, 0, 5, 8], [0, 100, 5, 8]] });
+  const radius = (c) => Math.hypot(c.arc[0][0] - c.centre[0], c.arc[0][1] - c.centre[1]);
+  const mapng = buildSidewalkMeshes([ew, ns]).corners;
+  assert.ok(mapng.length === 4 && mapng.every((c) => Math.abs(radius(c) - 3) < 1e-6), 'MapNG: 3 m');
+  const uk = buildSidewalkMeshes([ew, ns], { cornerRadii: UK_CORNER_RADII }).corners;
+  assert.ok(uk.length === 4 && uk.every((c) => Math.abs(radius(c) - 6) < 1e-6), `UK: ${uk.map(radius)}`);
+  const dist = buildSidewalkMeshes([ew, { ...ns, highway: 'tertiary' }], { cornerRadii: UK_CORNER_RADII }).corners;
+  assert.ok(dist.length === 4 && dist.every((c) => Math.abs(radius(c) - 10) < 1e-6), `with a tertiary: ${dist.map(radius)}`);
+  for (const c of uk) for (const [x, y] of c.arc) assert.ok(Math.abs(x) >= 4 - 1e-6 && Math.abs(y) >= 4 - 1e-6, 'off both carriageways');
+  // a lane behind the north-east corner leaves no room for 6 m: it keeps 5 m (tried in sixths), not half (3 m)
+  const lane = { owner: 3, half: 1, highway: 'service', urban: false, tags: { sidewalk: 'no' }, continuations: [], nodes: [[9.8, 6.8, 5, 2], [6.8, 9.8, 5, 2]] };
+  const blocked = buildSidewalkMeshes([ew, ns, lane], { cornerRadii: UK_CORNER_RADII }).corners;
+  const ne = blocked.find((c) => c.centre[0] > 0 && c.centre[1] > 0);
+  assert.ok(ne && Math.abs(radius(ne) - 5) < 1e-6, `north-east corner: ${ne && radius(ne)}`);
+  assert.equal(blocked.filter((c) => Math.abs(radius(c) - 6) < 1e-6).length, 3);
+});
