+test('a UK roundabout entry: 1003.1 Give Way line at the ring, no triangle', () => {
+  const size = 64;
+  const g = (x, y) => ({ lat: J + y / M, lng: J + x / M });
+  const ringPts = Array.from({ length: 13 }, (_, i) => { const a = -(i / 12) * 2 * Math.PI; return [14 * Math.cos(a), 14 * Math.sin(a)]; });
+  const td = {
+    width: size, height: size, minHeight: 0, maxHeight: 50, heightMap: new Float32Array(size * size).fill(10),
+    bounds: { north: 0.01, south: 0, west: 0, east: 0.01 }, metersPerPixel: (0.01 * 111320) / size, roadRules: GB,
+    osmFeatures: [
+      { id: 'ring', type: 'road', tags: { name: 'ring', highway: 'tertiary', junction: 'roundabout' }, geometry: ringPts.map(([x, y]) => g(x, y)) },
+      { id: 'entry', type: 'road', tags: { name: 'entry', highway: 'residential' }, geometry: [g(-80, 0), g(-40, 0), g(-14, 0)] },
+    ],
+  };
+  const decals = allDecals(generateDecalRoads(td, td.metersPerPixel));
+  const lines = decals.filter((d) => d.name.startsWith('jm_giveway_roundabout'));
+  assert.equal(lines.length, 1);
+  assert.equal(lines[0].material, 'uk_dash_1000_1000_cubewood');
+  assert.ok(lines[0].nodes.every((n) => n[3] === 0.266667), '200 mm');
+  assert.ok(lines[0].nodes.every(([x]) => x < -14), 'outside the ring, on the entry');
+  assert.equal(decals.filter((d) => d.name.startsWith('jm_giveway_triangle')).length, 0);
+  assert.equal(decals.filter((d) => d.name.startsWith('jm_edge_1009a')).length, 0);
+});
