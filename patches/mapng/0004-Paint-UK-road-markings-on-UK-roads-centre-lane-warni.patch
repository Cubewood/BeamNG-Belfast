+// T junction in a 1.1 km box: the secondary `main` runs east-west through J,
+// the tertiary `side` comes up from the south and stops at it.
+function tJunction(roadRules, sideTags = {}, extra = []) {
+  const size = 64;
+  const road = (id, tags, coords) => ({ id, type: 'road', tags: { name: id, ...tags }, geometry: coords.map(([lat, lng]) => ({ lat, lng })) });
+  return {
+    width: size, height: size, minHeight: 0, maxHeight: 50,
+    heightMap: new Float32Array(size * size).fill(10),
+    bounds: { north: 0.01, south: 0, west: 0, east: 0.01 },
+    metersPerPixel: (0.01 * 111320) / size,
+    roadRules,
+    osmFeatures: [
+      road('main', { highway: 'secondary', maxspeed: '40 mph' }, [[J, 0.001], [J, J], [J, 0.009]]),
+      road('side', { highway: 'tertiary', maxspeed: '30 mph', ...sideTags }, [[0.001, J], [J - 0.0002, J], [J, J]]),
+      ...extra,
+    ],
+  };
+}
+const allDecals = (groups) => {
+  const out = [];
+  const walk = (items) => items.forEach((it) => { if (it.class === 'DecalRoad') out.push(it); if (it.__items) walk(it.__items); });
+  walk(groups);
+  return out;
+};
+
+test('a UK export paints its lines with the UK materials; Ireland keeps MapNG\'s', () => {
+  const td = tJunction(GB);
+  const decals = allDecals(generateDecalRoads(td, td.metersPerPixel));
+  const paint = decals.filter((d) => /^(m_line|uk_)/.test(d.material));
+  assert.ok(paint.length > 0);
+  assert.ok(paint.every((d) => d.material.startsWith('uk_')), `stock lines left: ${paint.filter((d) => !d.material.startsWith('uk_')).map((d) => d.material)}`);
+  const mats = new Set(paint.map((d) => d.material));
+  assert.ok(mats.has('uk_centre_1008_cubewood') && mats.has('uk_warning_1004_cubewood') && mats.has('uk_solid_white_cubewood'), [...mats].join(' '));
+  for (const d of paint) assert.equal(d.textureLength, UK_MARKINGS[Object.keys(UK_MARKINGS).find((k) => UK_MARKINGS[k].material === d.material)].textureLength);
+  // the side road's warning line ends at the junction: its north end is the one nearest J (the world origin)
+  const sideWarn = paint.filter((d) => d.material === 'uk_warning_1004_cubewood' && d.nodes.every(([x]) => Math.abs(x) < 3));
+  assert.ok(sideWarn.length > 0, 'warning line on the side road');
+  assert.ok(sideWarn.every((d) => d.nodes.every(([, y]) => y < 0 && y > -40)), 'within 30 m and the trim of the junction');
+  const names = decals.map((d) => d.name);
+  assert.equal(new Set(names).size, names.length, 'decal names stay unique');
+
+  const ie = allDecals(generateDecalRoads(tJunction(IE), td.metersPerPixel));
+  const iePaint = ie.filter((d) => /^(m_line|uk_)/.test(d.material));
+  assert.ok(iePaint.length > 0 && iePaint.every((d) => d.material.startsWith('m_line') && d.textureLength === 6.4));
+});
