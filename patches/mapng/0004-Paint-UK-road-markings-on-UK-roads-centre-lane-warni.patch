+test('warning line 1004 / 1004.1 on the approach where the centre line stops at a junction', () => {
+  const end = { center: 4, pos: 4, neg: 4 };
+  const line = Array.from({ length: 101 }, (_, i) => [i * 2, 0, 0, 0.13]);   // 200 m straight
+  for (const [mph, material, length, approachM] of [[30, 'uk_warning_1004_cubewood', 6, 30], [40, 'uk_warning_1004_cubewood', 6, 42], [50, 'uk_warning_1004_1_cubewood', 9, 63]]) {
+    const layers = one(uk('tertiary', { maxspeed: `${mph} mph` }, 3.5, { endTrim: end }), 'line_center');
+    assert.equal(layers.length, 2, 'centre line and its warning stretch');
+    const warn = layers.find((l) => l.material === material);
+    const main = layers.find((l) => l !== warn);
+    assert.ok(warn && warn.textureLength === length && warn.levelName === 'Warning Line');
+    const w = ukLineNodes(line, warn); const m = ukLineNodes(line, main);
+    assert.ok(near(pathLength(w), approachM, 1e-3), `${mph} mph: ${pathLength(w)} m of warning line`);
+    assert.ok(near(w[0][0], 200 - approachM, 1e-3) && near(w[w.length - 1][0], 200, 1e-3), 'at the junction end');
+    assert.ok(near(pathLength(m), 200 - approachM, 1e-3), 'the rest stays a centre line');
+  }
+  // both ends at junctions and the road too short for both and a module: all warning line
+  const both = one(uk('tertiary', { maxspeed: '30 mph' }, 3.5, { startTrim: end, endTrim: end }), 'line_center');
+  assert.equal(both.length, 3);
+  const short = Array.from({ length: 31 }, (_, i) => [i * 2, 0, 0, 0.13]);   // 60 m
+  const kept = both.map((l) => ukLineNodes(short, l)).filter((n) => n.length >= 2);
+  assert.equal(kept.length, 1);
+  assert.ok(near(pathLength(kept[0]), 60, 1e-3));
+  // no junction: no warning
+  assert.equal(one(uk('tertiary', { maxspeed: '30 mph' }), 'line_center').length, 1);
+  // lane lines change only on the approach their traffic drives to (one-way: the end)
+  const oneWay = uk('trunk', { maxspeed: '30 mph', oneway: 'yes', lanes: '2' }, 3.5, { startTrim: end, endTrim: end });
+  const seps = oneWay.filter((l) => l.name.startsWith('line_sep_'));
+  assert.deepEqual(seps.map((l) => l.ukPiece.part).sort(), ['end', 'main']);
+  assert.equal(seps.find((l) => l.ukPiece.part === 'end').material, 'uk_warning_1004_cubewood');
+  assert.equal(sliceNodesAlong(line, 10, 21).length, 7, 'slices keep the nodes between their ends');
+});
