+test('UK Give Way: double dashed line 1003A across the approach half, triangle 1023A apex first', () => {
+  const giveWay = { id: 'n1', type: 'poi', geometry: [{ lat: J - 0.0002, lng: J }], tags: { highway: 'give_way' } };
+  const decals = generateJunctionMarkingDecals(tJunction(GB, {}, [giveWay]), (0.01 * 111320) / 64);
+  const line = decals.filter((d) => d.name.startsWith('jm_giveway_') && !d.name.startsWith('jm_giveway_triangle'));
+  assert.equal(line.length, 1);
+  assert.equal(line[0].material, 'uk_giveway_1003a_cubewood');
+  assert.equal(line[0].textureLength, 0.9);
+  assert.ok(line[0].nodes.every((n) => n[3] === 0.8));
+  // northbound on the side road, left-hand traffic: the approach half is the west (negative x) side
+  assert.ok(line[0].nodes.every(([x]) => x < 0.01), 'on the left (kerb) half');
+  const [tri] = decals.filter((d) => d.name.startsWith('jm_giveway_triangle'));
+  assert.ok(tri, 'one triangle for the one approaching lane');
+  assert.equal(tri.material, 'uk_giveway_triangle_1023a_cubewood');
+  assert.ok(near(Math.hypot(tri.nodes[1][0] - tri.nodes[0][0], tri.nodes[1][1] - tri.nodes[0][1]), 4.285714, 2e-3), 'drawn once: length = textureLength');
+  const lineY = line[0].nodes[0][1];
+  assert.ok(tri.nodes[0][1] < tri.nodes[1][1] && tri.nodes[1][1] < lineY, 'runs north, towards the line: the driver meets the apex first');
+  // (the painted base is the texture's end margin, 0.268 m, short of the end node)
+  const gap = lineY - 0.35 - (tri.nodes[1][1] - 0.267857);
+  assert.ok(gap >= 2.1 && gap <= 2.75, `triangle base ${gap.toFixed(2)} m from the line`);
+
+  // MapNG paints no give-way line outside the UK
+  assert.equal(generateJunctionMarkingDecals(tJunction(IE, {}, [giveWay]), (0.01 * 111320) / 64).filter((d) => d.name.startsWith('jm_')).length, 0);
+});
