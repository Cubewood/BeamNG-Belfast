@@ -0,0 +1,210 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+import { buildLineMarkingLayers, generateDecalRoads, generateJunctionMarkingDecals } from '../services/exportBeamNGLevel.js';
+import {
+  isUkRoadRules, sliceNodesAlong, UK_MARKINGS, ukLineLayers, ukLineNodes, ukMarking, ukSpeedMph,
+} from '../services/ukRoadMarkings.js';
+
+const GB = { countryCode: 'GB', countryName: 'United Kingdom', region: 'Europe', leftHandTraffic: true };
+const IE = { countryCode: 'IE', countryName: 'Ireland', region: 'Europe', leftHandTraffic: true };
+const near = (a, b, eps = 1e-6) => Math.abs(a - b) <= eps;
+const uk = (highway, tags, half = 3.5, ctx = {}) => ukLineLayers(buildLineMarkingLayers(highway, tags, half, { style: 'white' }), highway, tags, { drivingHalfWidth: half, ...ctx });
+const one = (layers, name) => layers.filter((l) => l.name === name);
+const J = 0.005;
+const pathLength = (nodes) => nodes.slice(1).reduce((s, n, i) => s + Math.hypot(n[0] - nodes[i][0], n[1] - nodes[i][1]), 0);
+
+test('UK paint only for UK road rules', () => {
+  assert.equal(isUkRoadRules(GB), true);
+  assert.equal(isUkRoadRules(IE), false);
+  assert.equal(isUkRoadRules(null), false);
+  assert.equal(isUkRoadRules({ countryCode: 'US', region: 'Americas' }), false);
+});
+
