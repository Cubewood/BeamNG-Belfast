diff --git a/services/ukRoadMarkings.js b/services/ukRoadMarkings.js
new file mode 100644
index 0000000..3c84052
--- /dev/null
+++ b/services/ukRoadMarkings.js
@@ -0,0 +1,239 @@
+// UK road markings for a level whose road rules are the United Kingdom's
+// (countryCode GB). One table of the UK patterns MapNG paints (material,
+// DecalRoad textureLength, width) and the two hooks that use it:
+//   ukLineLayers     restyles buildLineMarkingLayers' lines (centre, lane,
+//                    edge) and adds warning lines on junction approaches;
+//   ukJunctionLines  the Stop, signal Stop and Give Way lines (with the Give
+//                    Way triangle) where the stop-bar pass paints.
+// Dimensions: DfT Traffic Signs Manual chapters 3 and 5 (joint with DfI
+// Northern Ireland), TSRGD 2016 and the Traffic Signs Regulations (Northern
+// Ireland) 1997. The materials and their textures are not made here: they
+// are drawn outside MapNG and shipped in the level's
+// art/uk_markings_cubewood/main.materials.json. Every other country keeps
+// MapNG's own paint (getMarkingStyle), and so do the UK's signs.
+import { parseMaxspeedMps } from './beamngMapNavigation.js';
+import { makeRoadNodeKey } from './roadNetwork.js';
+import { isOneWayRoad } from './roadWidth.js';
+
+export const isUkRoadRules = (roadRules) => roadRules?.countryCode === 'GB';
+
+// A line texture is painted across its middle 75 %: DecalRoad width = painted width / 0.75.
+const LINE_FILL = 0.75;
+
+// textureLength is one repeat of the pattern (mark + gap); a fixed `width` is
+// the DecalRoad width of a pattern that does not scale with its paint.
+export const UK_MARKINGS = Object.freeze({
+  centre_1008: { material: 'uk_centre_1008_cubewood', textureLength: 6 },
+  centre_1008_1: { material: 'uk_centre_1008_1_cubewood', textureLength: 9 },
+  lane_1005: { material: 'uk_lane_1005_cubewood', textureLength: 6 },
+  lane_1005_1: { material: 'uk_lane_1005_1_cubewood', textureLength: 9 },
+  warning_1004: { material: 'uk_warning_1004_cubewood', textureLength: 6 },
+  warning_1004_1: { material: 'uk_warning_1004_1_cubewood', textureLength: 9 },
+  solid_white: { material: 'uk_solid_white_cubewood', textureLength: 2 },
+  double_white_solid_1013_1: { material: 'uk_double_white_solid_1013_1_cubewood', textureLength: 2, width: 0.633333 },
+  double_white_mixed_1013_1: { material: 'uk_double_white_mixed_1013_1_cubewood', textureLength: 6, width: 0.633333 },
+  giveway_1003a: { material: 'uk_giveway_1003a_cubewood', textureLength: 0.9, width: 0.8 },
+  triangle_1023a: { material: 'uk_giveway_triangle_1023a_cubewood', textureLength: 4.285714, width: 1.428571 },
+  // in the level for the junction, roundabout, crossing and kerbside work; not placed here
+  dash_600_300: { material: 'uk_dash_600_300_cubewood', textureLength: 0.9 },
+  dash_1000_1000: { material: 'uk_dash_1000_1000_cubewood', textureLength: 2 },
+  giveway_mini_1003_3: { material: 'uk_giveway_mini_1003_3_cubewood', textureLength: 1 },
+  solid_yellow: { material: 'uk_solid_yellow_cubewood', textureLength: 2 },
+  double_yellow_1018_1: { material: 'uk_double_yellow_1018_1_cubewood', textureLength: 2 },
+  zigzag_1001_4: { material: 'uk_zigzag_1001_4_cubewood', textureLength: 4.3, width: 0.571429 },
+  box_hatch_1043: { material: 'uk_box_hatch_1043_cubewood', textureLength: 2.828427, width: 2.828427 },
+  box_hatch_1043_wide: { material: 'uk_box_hatch_1043_wide_cubewood', textureLength: 3.535534, width: 3.535534 },
+});
+
+const round = (v, d = 6) => Math.round(v * 10 ** d) / 10 ** d;
+
+/** { material, textureLength, width } of a UK pattern; `paintMm` is the painted width of a line pattern. */
+export function ukMarking(key, paintMm = 100) {
+  const m = UK_MARKINGS[key];
+  if (!m) throw new Error(`no UK marking ${key}`);
+  return { material: m.material, textureLength: m.textureLength, width: m.width ?? round(paintMm / 1000 / LINE_FILL) };
+}
+
+/** The way's limit in mph (OSM maxspeed); unmapped: 70 on a motorway, else a restricted road's 30. */
+export function ukSpeedMph(tags = {}, highway = '') {
+  const mps = parseMaxspeedMps(tags);
+  if (mps) return Math.round(mps / 0.44704);
+  return /^motorway/.test(String(highway)) ? 70 : 30;
+}
+
+// The small module (6 m) up to 40 mph, the large one (9 m) above (TSM 5 2.1.2).
+const isLarge = (mph) => mph > 40;
+// warning marks on a junction approach (TSM 5 Table 2-3): 5 at 30 mph, 7 above;
+// 7 and 10 on four- or six-lane single carriageways
+const approachMarks = (mph, multiLane) => (mph <= 30 ? (multiLane ? 7 : 5) : (multiLane ? 10 : 7));
+
+const isNo = (v) => String(v ?? '').trim().toLowerCase() === 'no';
+const isReverseOneWay = (tags) => ['-1', 'reverse'].includes(String(tags.oneway ?? '').trim().toLowerCase());
+
+/**
+ * buildLineMarkingLayers' lines (the 'white' style) in UK paint, before the
+ * lane shift is added. Left-hand traffic: forward lanes ride the positive
+ * (left) side, so the centre and lane lines of a road with unequal lane
+ * counts are mirrored. Where the road's centre line stops at a junction
+ * (startTrim / endTrim .center > 0) its last metres become a warning line,
+ * and so do the lane lines on that approach.
+ *   centre: 1008 / 1008.1; overtaking=no double white 1013.1 (both lines
+ *           continuous), overtaking:forward|backward=no the continuous line
+ *           on that traffic's side (texture: continuous on the image left)
+ *   lane:   1005 / 1005.1      edge: 1012.1 continuous     warning: 1004 / 1004.1
+ * Layers get `ukPiece` (a stretch of the trimmed line) and `ukReverse`
+ * (node order reversed), applied by ukLineNodes.
+ */
+export function ukLineLayers(layers, highway, tags = {}, { drivingHalfWidth = 3.5, startTrim = null, endTrim = null } = {}) {
+  const mph = ukSpeedMph(tags, highway);
+  const large = isLarge(mph);
+  const module = large ? 9 : 6;
+  const centre = layers.find((l) => l.name === 'line_center');
+  const seps = layers.filter((l) => l.name.startsWith('line_sep_'));
+  const oneWay = isOneWayRoad(tags);
+  const lanes = seps.length + (centre ? 2 : 1);
+  // 150 mm on two-way roads of three lanes or more, or 10 m wide or more (TSM 5 Table 2-1, 2-3)
+  const wideRoad = !oneWay && (lanes >= 3 || 2 * drivingHalfWidth >= 10);
+  const fast = mph >= 70;
+  const centreMm = wideRoad || fast ? 150 : 100;
+  const laneMm = fast ? 150 : 100;
+  const approachM = approachMarks(mph, !oneWay && lanes >= 4) * module;
+  const atStart = (startTrim?.center ?? 0) > 0;
+  const atEnd = (endTrim?.center ?? 0) > 0;
+  const centreOffset = centre ? -centre.offset : 0;
+
+  // a line with warning stretches at the junction ends it approaches
+  // (the centre's warning line as wide as the centre line, a lane line's as the lane line: TSM 5 Table 2-3)
+  const withWarnings = (layer, look, warnMm, ws, we, levelName) => {
+    if (!(ws > 0) && !(we > 0)) return [{ ...layer, ...look }];
+    const piece = (part) => ({ part, ws, we, minMain: module });
+    const warn = ukMarking(large ? 'warning_1004_1' : 'warning_1004', warnMm);
+    const out = [{ ...layer, ...look, ukPiece: piece('main') }];
+    if (ws > 0) out.push({ ...layer, ...warn, ukPiece: piece('start'), levelName });
+    if (we > 0) out.push({ ...layer, ...warn, ukPiece: piece('end'), levelName });
+    return out;
+  };
+
+  const out = [];
+  for (const layer of layers) {
+    if (layer.name === 'line_center') {
+      const mirrored = { ...layer, offset: -layer.offset };
+      const fwdNo = isNo(tags.overtaking) || isNo(tags['overtaking:forward']);
+      const backNo = isNo(tags.overtaking) || isNo(tags['overtaking:backward']);
+      if (fwdNo && backNo) out.push({ ...mirrored, ...ukMarking('double_white_solid_1013_1') });
+      else if (fwdNo || backNo) out.push({ ...mirrored, ...ukMarking('double_white_mixed_1013_1'), ...(backNo ? { ukReverse: true } : {}) });
+      else {
+        const look = ukMarking(large ? 'centre_1008_1' : 'centre_1008', centreMm);
+        out.push(...withWarnings(mirrored, look, centreMm, atStart ? approachM : 0, atEnd ? approachM : 0, 'Warning Line'));
+      }
+    } else if (layer.name.startsWith('line_sep_')) {
+      const mirrored = { ...layer, offset: -layer.offset };
+      // the end its lanes' traffic drives towards
+      const towardEnd = oneWay ? !isReverseOneWay(tags) : mirrored.offset > centreOffset;
+      const look = ukMarking(large ? 'lane_1005_1' : 'lane_1005', laneMm);
+      out.push(...withWarnings(mirrored, look, laneMm, !towardEnd && atStart ? approachM : 0, towardEnd && atEnd ? approachM : 0));
+    } else if (layer.name === 'line_left' || layer.name === 'line_right') {
+      out.push({ ...layer, ...ukMarking('solid_white', fast ? 150 : 100) });
+    } else out.push(layer);
+  }
+  return out;
+}
+
+// [x, y, z, w] at distance d along nodes (cum: cumulative lengths)
+const nodeAtDistance = (nodes, cum, d) => {
+  let i = 1;
+  while (i < nodes.length - 1 && cum[i] < d) i++;
+  const span = cum[i] - cum[i - 1];
+  const t = span > 1e-9 ? Math.max(0, Math.min(1, (d - cum[i - 1]) / span)) : 0;
+  return nodes[i - 1].map((v, k) => (k < 3 ? round(v + (nodes[i][k] - v) * t, 3) : v + (nodes[i][k] - v) * t));
+};
+
+/** The stretch [fromM, toM] of a polyline of DecalRoad nodes. */
+export function sliceNodesAlong(nodes, fromM, toM) {
+  if (!Array.isArray(nodes) || nodes.length < 2 || !(toM > fromM)) return [];
+  const cum = [0];
+  for (let i = 1; i < nodes.length; i++) cum.push(cum[i - 1] + Math.hypot(nodes[i][0] - nodes[i - 1][0], nodes[i][1] - nodes[i - 1][1]));
+  const a = Math.max(0, fromM); const b = Math.min(cum[cum.length - 1], toM);
+  if (!(b > a)) return [];
+  const out = [nodeAtDistance(nodes, cum, a)];
+  for (let i = 1; i < nodes.length - 1; i++) if (cum[i] > a && cum[i] < b) out.push(nodes[i]);
+  out.push(nodeAtDistance(nodes, cum, b));
+  return out;
+}
+
+/**
+ * A UK line layer's nodes after the junction trim: its ukPiece stretch
+ * (main, or the warning at the start or end; a line too short for both
+ * warnings and one module between them is one warning line), reversed for
+ * ukReverse. Layers without either come back unchanged.
+ */
+export function ukLineNodes(nodes, layer) {
+  if (!layer?.ukPiece && !layer?.ukReverse) return nodes;
+  let out = nodes;
+  const p = layer.ukPiece;
+  if (p && Array.isArray(nodes) && nodes.length >= 2) {
+    let L = 0;
+    for (let i = 1; i < nodes.length; i++) L += Math.hypot(nodes[i][0] - nodes[i - 1][0], nodes[i][1] - nodes[i - 1][1]);
+    if (L - p.ws - p.we < p.minMain) out = p.part === (p.ws > 0 ? 'start' : 'end') ? nodes : [];
+    else if (p.part === 'start') out = sliceNodesAlong(nodes, 0, p.ws);
+    else if (p.part === 'end') out = sliceNodesAlong(nodes, L - p.we, L);
+    else out = sliceNodesAlong(nodes, p.ws, L - p.we);
+  }
+  return layer.ukReverse && out.length >= 2 ? [...out].reverse() : out;
+}
+
+const isRoundaboutTags = (tags = {}) => ['roundabout', 'circular'].includes(String(tags.junction ?? '').trim().toLowerCase());
+
+/** What ukJunctionLines needs of an export: its junction approaches and mini-roundabout nodes. */
+export function ukJunctionContext(features = [], junctions = null) {
+  const miniRoundabouts = new Set();
+  for (const f of features) {
+    if (f?.geometry?.length === 1 && f.tags?.highway === 'mini_roundabout') miniRoundabouts.add(makeRoadNodeKey(f.geometry[0]));
+  }
+  return { junctions, miniRoundabouts };
+}
+
+// Give Way line 1003A: two rows 200 mm wide, 300 mm apart (700 mm painted).
+const GIVEWAY_PAINT_HALF_M = 0.35;
+// Triangle 1023A: its base 2.1 to 2.75 m from the line (TSM 3 3.2.5), here
+// 2.4 m; the texture leaves (4.2857 - 3.75) / 2 m clear at each end.
+const TRIANGLE_GAP_M = 2.4;
+const TRIANGLE_END_MARGIN_M = (4.285714 - 3.75) / 2;
+const TRIANGLE_MIN_LANE_M = 1.6;
+
+/**
+ * The UK lines at one approach of the stop-bar pass, as straight DecalRoads
+ * [{ name, cx, cy, dir, from, to, material, textureLength, width }] from
+ * (cx, cy) + dir·from to (cx, cy) + dir·to. `at` is the pass's own geometry:
+ * the stop point (px, py), travel direction `dir`, unit `kerb` (across, to
+ * the kerb) and the span fromM..halfW across the approach lanes.
+ *   signals: Stop line 1001, 200 mm (300 mm at 40 mph and over)
+ *   STOP sign: Stop line 1002.1, 400 mm
+ *   give way: Give Way line 1003A and a triangle 1023A in each approaching
+ *             lane, apex first (the DecalRoad runs in the direction of travel)
+ * A give-way at a roundabout or mini-roundabout is left unpainted (its line is 1003.1 or 1003.3).
+ */
+export function ukJunctionLines(approach, context, { px, py, dir, kerb, fromM, halfW }) {
+  const junctions = context?.junctions;
+  const mph = ukSpeedMph(approach.road?.tags || {}, approach.highway);
+  const across = (name, look) => ({ name, cx: px, cy: py, dir: kerb, from: fromM, to: halfW, ...look });
+  if (junctions?.stopApproaches?.includes(approach)) return [across('jm_stopline', ukMarking('solid_white', 400))];
+  if (!junctions?.yieldApproaches?.includes(approach)) return [across('jm_stopline', ukMarking('solid_white', mph >= 40 ? 300 : 200))];
+  const node = junctions.graph?.nodes?.get(approach.junctionKey);
+  if (context.miniRoundabouts?.has(approach.junctionKey) || node?.edges?.some((e) => isRoundaboutTags(e.road?.tags))) return [];
+  const lines = [across('jm_giveway', ukMarking('giveway_1003a'))];
+  const tri = ukMarking('triangle_1023a');
+  const lanes = Math.max(1, approach.lanesIn || 1);
+  const span = halfW - fromM;
+  if (span / lanes >= TRIANGLE_MIN_LANE_M) {
+    const back = GIVEWAY_PAINT_HALF_M + TRIANGLE_GAP_M - TRIANGLE_END_MARGIN_M;
+    for (let k = 0; k < lanes; k++) {
+      const lateral = fromM + ((k + 0.5) * span) / lanes;
+      lines.push({
+        name: 'jm_giveway_triangle', cx: px + kerb[0] * lateral, cy: py + kerb[1] * lateral, dir,
+        from: -(back + tri.textureLength), to: -back, ...tri,
+      });
+    }
+  }
+  return lines;
+}
